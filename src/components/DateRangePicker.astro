---
// §4 Date Range Picker — check-in / check-out for the lodge stay flow.
// Deliberately NOT a generic date picker: it knows about availability
// (booked, check-in-only, check-out-only), stay length and same-day turnover.
// This file renders the static shell; scripts/date-range-picker.js
// hydrates it (calendar grid, availability loading, selection, keyboard).
// The rules live in scripts/lodge-date-rules.js as pure functions.
//
// One selection engine, two presentations, one DOM:
//   ≥ md   dropdown below the field, two months, hover preview, commits the
//          moment a valid check-out is chosen
//   < md   full-screen sheet, one month, sticky summary + Apply (nothing is
//          committed until Apply)
//
// Dates are plain 'YYYY-MM-DD' strings everywhere. The value is submitted as
// one hidden input in ISO-8601 interval form, "2026-10-12/2026-10-14", and
// is empty when nothing is selected. The parent owns the value: the picker only
// mirrors it, and setValue() re-syncs it from outside.
//
// Callbacks can't be props on a build-time component, so each onX prop from the
// spec is a bubbling DOM event instead: date-range:change | invalid |
// loaderror | open | close. Functions (minNights / maxNights as a function of
// the start date, the availability source) go through
// DateRangePicker.get(el).setRules() / .setSource().
//
// mode="single" runs the same engine for one date (one month, no nights, value
// is one 'YYYY-MM-DD' string). Use DatePicker.astro for that: it is this
// component with the single-date API. Not documented as a range option because
// presets, minNights and maxNights mean nothing there.
//
// Status: experimental (one use, the design-system page).
import Icon from './Icon.astro';
import IconButton from './IconButton.astro';
import Button from './Button.astro';

export interface DateRange {
  start: string;
  end: string;
}

export interface Preset {
  label: string;
  // A fixed range, or 'this-weekend' (resolved in the browser, relative to today).
  range: DateRange | 'this-weekend';
}

export interface Props {
  mode?: 'range' | 'single';
  label?: string;
  ariaLabel?: string;
  id?: string;
  name?: string;
  placeholder?: string;
  help?: string;
  error?: string;
  value?: DateRange | string | null;
  defaultValue?: DateRange | string | null;
  disabled?: boolean;
  minDate?: string;
  maxDate?: string;
  minNights?: number;
  maxNights?: number;
  blackoutDates?: string[];
  presets?: Preset[];
  class?: string;
}

const {
  label,
  ariaLabel,
  id = `drp-${Math.random().toString(36).slice(2, 9)}`,
  name,
  mode = 'range',
  placeholder = mode === 'single' ? 'Select a date' : 'Select check-in and check-out',
  help,
  error,
  defaultValue,
  disabled = false,
  class: extraClass = '',
  ...config
} = Astro.props;

const value = config.value ?? defaultValue ?? null;
const labelId = `${id}-label`;
const valueId = `${id}-value`;
const panelId = `${id}-panel`;
const helpId = help ? `${id}-help` : undefined;
const feedbackId = `${id}-feedback`;
const title = label ?? ariaLabel ?? 'Select dates';
const single = mode === 'single';
const presets = single ? [] : (config.presets ?? []);

const json = (data: unknown) => JSON.stringify(data).replace(/</g, '\\u003c');
const clientConfig = { ...config, mode, presets, value, placeholder, error, disabled };
const hiddenValue = !value ? '' : (typeof value === 'string' ? value : `${value.start}/${value.end}`);
---

<div
  class={['date-range', single ? 'date-range--single' : '', extraClass].filter(Boolean).join(' ')}
  data-date-range
  data-config={json(clientConfig)}
>
  {label && <label class="form-label" id={labelId} for={id}>{label}</label>}

  <div class="date-range__anchor">
    <button
      type="button"
      class="form-control date-range__field"
      id={id}
      aria-haspopup="dialog"
      aria-expanded="false"
      aria-controls={panelId}
      aria-labelledby={label ? `${labelId} ${valueId}` : undefined}
      aria-label={label ? undefined : (ariaLabel ?? placeholder)}
      aria-describedby={helpId}
      data-describedby={helpId}
      disabled={disabled}
    >
      <span class="date-range__value is-placeholder" id={valueId}>{placeholder}</span>
      <Icon name="calendar_month" size={24} class="date-range__icon" />
    </button>

    <div
      class="date-range__panel"
      id={panelId}
      role="dialog"
      aria-label={title}
      tabindex="-1"
      hidden
    >
      <div class="date-range__bar">
        <span class="date-range__title" aria-hidden="true">{title}</span>
        <IconButton icon="close" label="Close calendar" variant="plain" class="date-range__close" />
      </div>

      <div class="date-range__body">
        <div class="date-range__months">
          <IconButton icon="chevron_left" label="Previous month" variant="plain" class="date-range__nav date-range__prev" />
          <IconButton icon="chevron_right" label="Next month" variant="plain" class="date-range__nav date-range__next" />
          <div class="date-range__panes" data-dr-panes></div>
        </div>

        <p class="date-range__message" role="alert" data-dr-message></p>

        <ul class="date-range__legend list-unstyled small" aria-label="Calendar key">
          {!single && <li><Icon name="login" size={16} /> Check-in only</li>}
          {!single && <li><Icon name="logout" size={16} /> Check-out only</li>}
          <li><span class="date-range__legend-booked">12</span> {single ? 'Unavailable' : 'Booked'}</li>
        </ul>
      </div>

      {!single && (
        <div class="date-range__footer">
          <p class="date-range__summary" data-dr-summary>Select check-in date</p>
          <div class="date-range__actions">
            {presets.map((preset, index) => (
              <Button variant="text" class="date-range__preset" data-dr-preset={index}>{preset.label}</Button>
            ))}
            <Button variant="text" class="date-range__clear" data-dr-clear disabled>Clear</Button>
            <Button variant="primary" class="date-range__apply" data-dr-apply disabled>Apply</Button>
          </div>
        </div>
      )}

      <div class="visually-hidden" role="status" aria-live="polite" aria-atomic="true" data-dr-live></div>
    </div>
  </div>

  <div class="invalid-feedback" id={feedbackId}>{error}</div>
  {help && <div class="form-text" id={helpId}>{help}</div>}
  <input type="hidden" name={name} value={hiddenValue} data-dr-hidden />
</div>

<script>
  import { initDateRangePickers } from '../scripts/date-range-picker.js';

  initDateRangePickers();
</script>

---
// §9 Known Gaps "Footer component" — not in the source guidelines. Built in
// Figma 01 Sep 2026: three link columns (THE FARM / VISIT / CONNECT), divider,
// copyright line. Link labels and copyright are the real terms pulled from
// the live site's own footer markup — column grouping is a proposed curation.

import Tag from "./Tag.astro";
import SocialFooter from "./SocialFooter.astro";
import LegalFooter from "./LegalFooter.astro";
export interface Props {
  columns?: { title: string; links: { label: string; href: string }[] }[];
  
  copyright?: string;
  class?: string;
  image?: { src: string; alt: string };
}

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const {
  image = {
    src: `${base}/images/footer- silhouette.png`,
    alt: "An outdoor dining terrace overlooking the camp at Heenat Salma Farm",
  },
  columns = [
    {
      title: "The Farm",
      links: [
        { label: "About", href: `${base}/about/` },
        {
          label: "Organic Regenerative Agriculture",
          href: `${base}/organic-regenerative-agriculture/`,
        },
        { label: "Artisanal Kitchen", href: `${base}/artisanal-kitchen/` },
        {
          label: "Caravane Earth Academy",
          href: `${base}/caravane-earth-academy/`,
        },
        { label: "Careers", href: `${base}/careers/` },
      ],
    },
    {
      title: "Visit",
      links: [
        { label: "Lodges", href: `${base}/lodges/` },
        { label: "Guest Journey", href: `${base}/guest-journey/` },
        { label: "Experiences", href: `${base}/experiences/` },
        { label: "Home Services", href: `${base}/home-services/` },
        { label: "Events", href: `${base}/events/` },
      ],
    },
    {
      title: "Connect",
      links: [
        { label: "Store", href: `${base}/store/` },
        { label: "Wellness", href: `${base}/wellness/` },
        { label: "Creative Residency", href: `${base}/creative-residency/` },
        { label: "Contact Us", href: `${base}/contact/` },
        { label: "Cookie Policy (EU)", href: `${base}/cookie-policy/` },
      ],
    },
  ],
  
  copyright = "© 2026 Heenat Salma Farm by Caravane Earth Foundation",
  class: extraClass = "",
} = Astro.props;
---

<div class="footer-gredient pt-6 px-lg-0 px-3">
  <footer class={["footer-bg-wrapper", extraClass].filter(Boolean).join(" ")}>
    <img class="footer-bg" src={image.src} alt={image.alt} />
    <SocialFooter/>
    <div class="container footer-bg-content py-6 reveal">
      <div class="row g-4 g-md-5">
        {
          columns.map((col) => (
            <div class="col-12 col-md-4">
               <Tag variant="filled" class="p-0 border-0 bg-transparent mb-3">{col.title}</Tag>
              <ul class="list-unstyled d-flex flex-column gap-2">
                {col.links.map((link) => (
                  <li>
                    <a
                      class="link-ink-soft link-underline-opacity-0 link-underline-opacity-100-hover"
                      href={link.href}
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </footer>

  <LegalFooter copyright={copyright} />
</div>
<style>
  .footer-gredient {
    background: linear-gradient(0deg, var(--bs-beige) 0%, var(--bs-cream) 100%);
  }
  .footer-bg {
    position: absolute;
    width: 100%;
    bottom: 0;
    mix-blend-mode: color-burn;
    opacity: 0.1;
  }
  .footer-bg-wrapper {
    position: relative;
    overflow: hidden;
  }
  .footer-bg-content {
    position: relative;
    z-index: 1;
  }
</style>

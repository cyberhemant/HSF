<style>
  .activities-section {
    padding-block: clamp(64px, 8vw, 112px);
  }

  .activity-card {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .activity-card:focus-visible {
    outline: 2px solid var(--bs-ochre-deep);
    outline-offset: 4px;
    border-radius: 4px;
  }

  .activity-card__frame {
    aspect-ratio: 2 / 3;
    width: 100%;
    overflow: hidden;
    border-radius: 999px 999px 0 0;
  }

  .activity-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  .activity-card:hover .activity-card__img,
  .activity-card:focus-visible .activity-card__img {
    transform: scale(1.06);
  }

  .activity-card h3 {
    transition: color 0.25s ease;
  }

  .activity-card:hover h3,
  .activity-card:focus-visible h3 {
    color: var(--bs-ochre-deep);
  }
</style>

---
// Four-up "pillar grid" of farm activities/classes — same content and real
// photography as the "Wellness & Treatments / Creative Classes /
// Agricultural workshops / Culinary Classes" block on heenatsalma.earth,
// rebuilt on this system's own components: Tag intro (LodgesShowcase.astro),
// arch-masked image (the pointed-arch mask from StaySection.astro, reused
// here at a rounder radius to match the reference's round-top arch), and
// scroll-reveal via .reveal (reveal.js).
// Responsive: 2-up below lg, 4-up from lg (extra cards wrap and stay centred).
// With an empty `activities` array the whole section is omitted rather than
// leaving a heading over nothing.
import Tag from './Tag.astro';

export interface Props {
  eyebrow?: string;
  heading?: string;
  lead?: string;
  activities?: { name: string; description: string; image: string; href: string }[];
  class?: string;
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const {
  eyebrow = 'Experience',
  heading = 'Experience the farm.',
  lead = 'We design experiences that are engaging, inspiring, and transformative, and that connect people with themselves, each other, and nature',
  activities = [
    {
      name: 'Wellness & Treatments',
      description: 'Healing rituals & renewal',
      image: 'https://heenatsalma.earth/wp-content/uploads/2025/09/wellness_body_heenat-salma-farm.jpg',
      href: `${base}/wellness/`,
    },
    {
      name: 'Creative Classes',
      description: 'Weaving, pottery & craft',
      image: 'https://heenatsalma.earth/wp-content/uploads/2025/09/creative_classes_heenat-salma-farm.jpg',
      href: `${base}/creative-classes/`,
    },
    {
      name: 'Agricultural Workshops',
      description: 'Permaculture, composting & tours',
      image: 'https://heenatsalma.earth/wp-content/uploads/2025/09/agriculture_education_heenat-salma-farm.jpg',
      href: `${base}/agricultural-workshops/`,
    },
    {
      name: 'Culinary Classes',
      description: 'Farm-to-table culinary journeys',
      image: 'https://heenatsalma.earth/wp-content/uploads/2025/09/culinary_classes_heenat-salma-farm.jpg',
      href: `${base}/culinary-classes/`,
    },
    {
      name: 'Organic Shop',
      description: 'Seasonal Vegetables',
      image: 'https://heenatsalma.earth/wp-content/uploads/2024/01/dscf7286.jpg',
      href: `${base}/store/`,
    },
    {
      name: 'Creative Residency',
      description: 'Residencies with Impact',
      image: 'https://heenatsalma.earth/wp-content/uploads/2024/01/untitledd-6-2_sm-1.jpg',
      href: `${base}/creative-residency/`,
    },
    {
      name: 'Organic Regenerative Agriculture',
      description: 'Organic regenerative agriculture',
      image: 'https://heenatsalma.earth/wp-content/uploads/2024/04/dscf8385.webp',
      href: `${base}/organic-regenerative-agriculture/`,
    },
  ],
  class: extraClass = '',
} = Astro.props;
---

{activities.length > 0 && (
  <section class={['activities-section', extraClass].filter(Boolean).join(' ')}>
    <div class="container">
      <div class="activities-section__head reveal text-center">
        <h2 class="mt-3 display-5">{heading}</h2>
        <p class="mt-3 text-ink-soft">{lead}</p>
      </div>

      <div class="row g-4 g-lg-5 mt-1 justify-content-center">
        {activities.map((activity, i) => (
          <div class="col-6 col-lg-3 reveal" style={`transition-delay:${i * 90}ms`}>
            <a class="activity-card" href={activity.href}>
              <div class="activity-card__frame">
                {/* Decorative: the activity name is right below, inside the same link. */}
                <img class="activity-card__img" src={activity.image} alt="" loading="lazy" />
              </div>
              <h3 class="h5 mt-4 text-center">{activity.name}</h3>
              <p class="small text-ink-soft text-center mt-2">{activity.description}</p>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>
)}


<style>
  .activities-section {
    padding-block: clamp(64px, 8vw, 112px);
  }

  .activity-card {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .activity-card:focus-visible {
    outline: 2px solid var(--bs-ochre-deep);
    outline-offset: 4px;
    border-radius: var(--bs-border-radius);
  }

  .activity-card__frame {
    aspect-ratio: 2 / 3;
    width: 100%;
    overflow: hidden;
    border-radius: 999px 999px 0 0;
  }

  .activity-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  .activity-card:hover .activity-card__img,
  .activity-card:focus-visible .activity-card__img {
    transform: scale(1.06);
  }

  .activity-card h3 {
    transition: color 0.25s ease;
  }

  .activity-card:hover h3,
  .activity-card:focus-visible h3 {
    color: var(--bs-ochre-deep);
  }

  @media (prefers-reduced-motion: reduce) {
    .activity-card__img {
      transition: none;
    }

    .activity-card:hover .activity-card__img,
    .activity-card:focus-visible .activity-card__img {
      transform: none;
    }
  }
</style>

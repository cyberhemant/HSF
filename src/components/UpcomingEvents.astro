---
// Upcoming Events — card carousel in the spirit of the "Restaurants & Bars
// / Dine & Unwind" section on ritzcarlton.com/.../sharq-village-and-spa:
// image-topped cards that scroll through a numbered, prev/next-controlled
// filmstrip, each card wholly a hyperlink out to the event. Built as a
// native scroll-snap track (own implementation, no carousel lib) rather
// than RoomGallery's single-image "peek" ring, since each slide here needs
// to carry a date + title + description rather than just a photo.
import Icon from './Icon.astro';
import Tag from './Tag.astro';

export interface Props {
  eyebrow?: string;
  heading?: string;
  lead?: string;
  events?: { title: string; description: string; date: string; image: string; alt?: string; href: string }[];
  class?: string;
}

const base = import.meta.env.BASE_URL;

const {
  eyebrow = 'Upcoming Events',
  heading = 'What’s On At The Farm',
  lead = 'From market evenings to sunrise wellness rituals, join us for gatherings that bring the farm’s rhythm to life.',
  events = [
    {
      title: 'Open Mic Night',
      description: 'An evening of live music, poetry, and storytelling around the fire pit, open to guests and neighbors alike.',
      date: 'Fri, 3 October 2026',
      image: `${base}/images/gallery-open-mic.webp`,
      alt: 'Open Mic Night at Heenat Salma Farm',
      href: `${base}/events/open-mic-night/`,
    },
    {
      title: 'Wellness Sunrise Retreat',
      description: 'A guided morning of breathwork, movement, and quiet reflection set against the farm’s tranquil landscape.',
      date: 'Sat, 11 October 2026',
      image: `${base}/images/gallery-wellness-experience.webp`,
      alt: 'Wellness experience at Heenat Salma Farm',
      href: `${base}/events/wellness-sunrise-retreat/`,
    },
    {
      title: 'Ramadan Bazar',
      description: 'A festive evening market with local artisans, seasonal produce, and farm-fresh treats under lantern light.',
      date: 'Thu, 18 February 2027',
      image: `${base}/images/gallery-ramadan-bazar.webp`,
      alt: 'Ramadan Bazar at Heenat Salma Farm',
      href: `${base}/events/ramadan-bazar/`,
    },
  ],
  class: extraClass = '',
} = Astro.props;

const total = events.length;
const pad = (n: number) => String(n).padStart(2, '0');
---

<section id="upcoming-events" class={['upcoming-events', extraClass].filter(Boolean).join(' ')} data-events-carousel>
  <div class="container">
    <div class="upcoming-events__head measure mx-auto text-center reveal">
      <Tag>{eyebrow}</Tag>
      <h2 class="mt-3 display-5">{heading}</h2>
      <p class="mt-3 text-ink-soft">{lead}</p>
    </div>

    <div class="upcoming-events__viewport mt-5 reveal">
      <div class="upcoming-events__track" data-role="track">
        {events.map((event) => (
          <a class="event-card" href={event.href}>
            <div class="event-card__frame">
              <img class="event-card__img" src={event.image} alt={event.alt || event.title} loading="lazy" />
              <span class="event-card__date">{event.date}</span>
            </div>
            <div class="event-card__body">
              <h3 class="h5 mb-2">{event.title}</h3>
              <p class="small text-ink-soft mb-3">{event.description}</p>
              <span class="event-card__cta text-ochre-deep small fw-semibold">
                Learn More <Icon name="chevron-right" size={14} />
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>

    {total > 1 && (
      <div class="upcoming-events__controls d-flex align-items-center justify-content-center gap-3 gap-md-4 mt-4">
        <button type="button" class="upcoming-events__nav" data-action="prev" aria-label="Previous event">
          <Icon name="chevron-left" size={16} />
          <span class="d-none d-sm-inline">Previous</span>
        </button>
        <span class="upcoming-events__count small text-ink-faint" data-role="count">{`${pad(1)} / ${pad(total)}`}</span>
        <div class="upcoming-events__track-bar" aria-hidden="true">
          <span class="upcoming-events__progress" data-role="progress" style={`width:${(1 / total) * 100}%`}></span>
        </div>
        <button type="button" class="upcoming-events__nav" data-action="next" aria-label="Next event">
          <span class="d-none d-sm-inline">Next</span>
          <Icon name="chevron-right" size={16} />
        </button>
      </div>
    )}
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-events-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-role="track"]');
    const cards = Array.from(track?.children ?? []) as HTMLElement[];
    const N = cards.length;
    if (!track || N < 1) return;

    const progressEl = root.querySelector<HTMLElement>('[data-role="progress"]');
    const countEl = root.querySelector<HTMLElement>('[data-role="count"]');
    const pad = (n: number) => String(n).padStart(2, '0');

    const activeIndex = () => {
      const trackRect = track.getBoundingClientRect();
      let index = 0;
      let minDist = Infinity;
      cards.forEach((card, i) => {
        const dist = Math.abs(card.getBoundingClientRect().left - trackRect.left);
        if (dist < minDist) {
          minDist = dist;
          index = i;
        }
      });
      return index;
    };

    const updateIndicators = () => {
      const index = activeIndex();
      if (progressEl) progressEl.style.width = `${((index + 1) / N) * 100}%`;
      if (countEl) countEl.textContent = `${pad(index + 1)} / ${pad(N)}`;
    };

    let scrollRaf: number | null = null;
    track.addEventListener('scroll', () => {
      if (scrollRaf !== null) return;
      scrollRaf = requestAnimationFrame(() => {
        scrollRaf = null;
        updateIndicators();
      });
    }, { passive: true });

    const scrollByCards = (delta: number) => {
      const card = cards[0];
      if (!card) return;
      const style = getComputedStyle(track);
      const gap = parseFloat(style.columnGap || style.gap || '0') || 0;
      track.scrollBy({ left: delta * (card.getBoundingClientRect().width + gap), behavior: 'smooth' });
    };

    root.querySelector<HTMLElement>('[data-action="prev"]')?.addEventListener('click', () => scrollByCards(-1));
    root.querySelector<HTMLElement>('[data-action="next"]')?.addEventListener('click', () => scrollByCards(1));

    updateIndicators();
  });
</script>

<style>
  .upcoming-events {
    padding-block: clamp(64px, 8vw, 112px);
  }

  .upcoming-events__head {
    max-width: 46ch;
  }

  .upcoming-events__viewport {
    overflow: hidden;
  }

  .upcoming-events__track {
    display: flex;
    gap: clamp(16px, 2vw, 32px);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline-start: 0;
    padding-block: 4px 8px;
    margin: -4px -8px -8px;
    padding-inline: 8px;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .upcoming-events__track::-webkit-scrollbar {
    display: none;
  }

  .event-card {
    flex: 0 0 min(340px, 82vw);
    scroll-snap-align: start;
    display: block;
    color: inherit;
    text-decoration: none;
  }

  @media (min-width: 768px) {
    .event-card {
      flex-basis: calc(50% - 16px);
    }
  }

  @media (min-width: 992px) {
    .event-card {
      flex-basis: calc(33.333% - 22px);
    }
  }

  .event-card:focus-visible {
    outline: 2px solid var(--bs-ochre-deep);
    outline-offset: 4px;
    border-radius: 4px;
  }

  .event-card__frame {
    position: relative;
    aspect-ratio: 4 / 3;
    width: 100%;
    overflow: hidden;
    border-radius: var(--bs-border-radius-lg);
  }

  .event-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  .event-card:hover .event-card__img,
  .event-card:focus-visible .event-card__img {
    transform: scale(1.06);
  }

  .event-card__date {
    position: absolute;
    inset-block-start: .75rem;
    inset-inline-start: .75rem;
    background-color: rgba(73, 16, 16, .75);
    color: #fff;
    padding: .3rem .75rem;
    border-radius: 999px;
    font-size: .7rem;
    text-transform: uppercase;
    letter-spacing: .08em;
    font-weight: 600;
  }

  .event-card__body {
    padding-block-start: 1rem;
  }

  .event-card h3 {
    transition: color 0.25s ease;
  }

  .event-card:hover h3,
  .event-card:focus-visible h3 {
    color: var(--bs-ochre-deep);
  }

  .event-card__cta :global(.material-symbols-outlined) {
    vertical-align: -3px;
    transition: transform .2s ease;
  }

  .event-card:hover .event-card__cta :global(.material-symbols-outlined),
  .event-card:focus-visible .event-card__cta :global(.material-symbols-outlined) {
    transform: translateX(3px);
  }

  .upcoming-events__nav {
    display: inline-flex;
    align-items: center;
    gap: .375rem;
    min-height: 2.75rem;
    padding-inline: .5rem;
    background: none;
    border: none;
    font-size: .85rem;
    text-transform: uppercase;
    letter-spacing: .08em;
    color: var(--bs-ink-soft);
    cursor: pointer;
    transition: color .2s ease;
  }

  .upcoming-events__nav:hover,
  .upcoming-events__nav:focus-visible {
    color: var(--bs-maroon);
  }

  .upcoming-events__count {
    letter-spacing: .04em;
    white-space: nowrap;
  }

  .upcoming-events__track-bar {
    position: relative;
    flex: 1 1 auto;
    max-width: 420px;
    height: 2px;
    background-color: var(--bs-border-color);
  }

  .upcoming-events__progress {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    background-color: var(--bs-ochre-deep);
    transition: width .3s ease;
  }
</style>

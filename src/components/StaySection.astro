---
// Split hero-style promo section, following the layout shown in the
// reference screenshot (text left / arch-masked image right), rebuilt on
// the site's own theme rather than the reference's colors: Alegreya serif
// heading in maroon (not blue), primary Button component, real lodge
// photography. The pointed arch is a nod to §1's "Islamic geometric
// ornament... earmarked for reuse on the website" — used here to frame a
// photograph, not as decorative filler on the logo.

import AnimatedOutlineButton from "./AnimatedOutlineButton.astro";
import Tag from "./Tag.astro";
import Divider from "./Divider.astro";
import ArchCarousel from "./ArchCarousel.astro";
export interface Props {
  eyebrow?: string;
  heading?: string;
  lead?: string;
  ctaLabel?: string;
  ctaHref?: string;
  images?: { src: string; alt: string }[];

  stats?: { value: string; label: string }[];
  class?: string;
}

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const {
  eyebrow = "LUXURY ECO-RETREAT & LODGING",
  heading = "Staying At The Farm",
  lead = "Escape to a serene sanctuary where traditional hospitality meets understated elegance. Nestled within tranquil desert landscapes, Heenat Salma Farm offers bespoke eco-lodging designed for deep relaxation and mindful living. Unwind in thoughtfully crafted rooms, indulge in private wellness experiences, and enjoy unmatched luxury surrounded by natural calm.",
  ctaLabel = "Book Lodges",
  ctaHref = `${base}/lodges/`,

  images = [
    {
      src: `${base}/images/lodge-two.webp`,
      alt: "An outdoor terrace at Heenat Salma Farm",
    },
    {
      src: `${base}/images/lodge-one.webp`,
      alt: "Lodge One at Heenat Salma Farm",
    },
    {
      src: `${base}/images/lodge-three.webp`,
      alt: "Lodge Three at Heenat Salma Farm",
    },
  ],
  stats = [
    { value: "100+", label: "Lodges & Tents" },
    { value: "4.9", label: "Experience Rating" },
    { value: "24/7", label: "Guest Support" },
  ],
  class: extraClass = "",
} = Astro.props;

const carouselId = "stay-carousel";
---

<section class={["position-relative", extraClass].filter(Boolean).join(" ")}>
  <div class="container">
    <div class="row flex-wrap-reverse align-items-center g-5 py-7">
      <div class="col-12 col-lg-6">
        <div class="px-md-0 px-3">
          <Tag variant="plain" class="pb-3">{eyebrow} </Tag>
          <h2 class="display-4">{heading}</h2>
          <p class="py-4">{lead}</p>

          <AnimatedOutlineButton variant="outline-primary" arrow href={ctaHref}
            >{ctaLabel}</AnimatedOutlineButton
          >
          <Divider variant="palm" />

          <div class="d-flex justify-content-between gap-3">
            {stats.map((stat) => (
              <div>
                <div>
                  <span class="fs-1 lh-1">{stat.value}</span>
                </div>
                <div>
                  <span class="text-uppercase ls-tag text-ink-faint small">{stat.label}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
      <div class="col-12 col-lg-1"></div>
      <div class="col-12 col-lg-5 text-center">
        <div data-aos="zoom-out-up">
          <ArchCarousel id={carouselId} {images} />
        </div>
      </div>
    </div>
  </div>
</section>



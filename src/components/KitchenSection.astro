---
// "Kitchen" promo — identical layout to StaySection.astro (text/stats left,
// arch-masked image carousel right, torn-paper rip strip on top), restyled
// with content from heenatsalma.earth's Artisanal Kitchen page: farm-to-table
// dining, in-house chef, seasonal set menu.

import AnimatedOutlineButton from "./AnimatedOutlineButton.astro";
import Tag from "./Tag.astro";
import Divider from "./Divider.astro";
import ArchCarousel from "./ArchCarousel.astro";

export interface Props {
  eyebrow?: string;
  heading?: string;
  lead?: string;
  ctaLabel?: string;
  ctaHref?: string;
  images?: { src: string; alt: string }[];
  stats?: { value: string; label: string }[];
  class?: string;
}

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const {
  eyebrow = "ARTISANAL KITCHEN",
  heading = "Heenat Salma Artisanal Kitchen",
  lead = "Farm-to-table isn't just a phrase here, it's a way of life. Every dish is thoughtfully prepared by our in-house chef using fresh, seasonal produce harvested directly from the farm — simple, healthy, nourishing meals on a curated set menu that changes with the seasons.",
  ctaLabel = "Know More",
  ctaHref = `${base}/kitchen/`,
  images = [
    {
      src: "https://heenatsalma.earth/wp-content/uploads/2025/10/farm-to-table-1.jpg",
      alt: "A farm-to-table dish at Heenat Salma Farm",
    },
    {
      src: "https://heenatsalma.earth/wp-content/uploads/2024/05/dscf7393.webp",
      alt: "Dining at the Heenat Salma Farm kitchen",
    },
    {
      src: "https://heenatsalma.earth/wp-content/uploads/2024/05/dsf0208.webp",
      alt: "Seasonal produce at the Heenat Salma Farm kitchen",
    },
  ],
  stats = [
    { value: "6", label: "Curated Courses" },
    { value: "10", label: "Heritage Food Crops" },
    { value: "100%", label: "Farm-To-Table" },
  ],
  class: extraClass = "",
} = Astro.props;

const carouselId = "kitchen-carousel";
---

<section class={["position-relative", extraClass].filter(Boolean).join(" ")}>
  <div class="container">
    <div class="row align-items-center g-5 py-7">
      <div class="col-12 col-lg-5 text-center">
        <div class="reveal">
          <ArchCarousel id={carouselId} {images} />
        </div>
      </div>
      <div class="col-12 col-lg-1"></div>
      <div class="col-12 col-lg-6">
        <div class="px-md-0 px-3">
          <Tag variant="plain" class="pb-3">{eyebrow}</Tag>
          <h2 class="display-4">{heading}</h2>
          <p class="py-4">{lead}</p>

          <AnimatedOutlineButton variant="outline-primary" arrow href={ctaHref}
            >{ctaLabel}</AnimatedOutlineButton
          >
          <Divider variant="palm" />

          <div class="d-flex justify-content-between gap-3">
            {stats.map((stat) => (
              <div>
                <div>
                  <span class="fs-1 lh-1">{stat.value}</span>
                </div>
                <div>
                  <span class="text-uppercase ls-tag text-ink-faint small">{stat.label}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

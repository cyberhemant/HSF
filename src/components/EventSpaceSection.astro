---
// "Event Space" promo — full-bleed parallax banner (fixed background-attachment)
// with a dark overlay for contrast, centered eyebrow/heading/lead/CTA in
// light (cream) text via Bootstrap's text-light / btn-outline-light. Same overlay-on-image treatment as the Hero video section,
// just as a static background image rather than video.
import Tag from './Tag.astro';
import Button from './Button.astro';

export interface Props {
  eyebrow?: string;
  heading?: string;
  lead?: string;
  ctaLabel?: string;
  ctaHref?: string;
  image?: string;
  class?: string;
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const {
  eyebrow = 'Gatherings & Celebrations',
  heading = 'Event Space',
  lead = 'Host your event amidst the quiet desert, working farmland, and shaded courtyards of Heenat Salma.',
  ctaLabel = 'Enquire About Events',
  ctaHref = `${base}/event-space/`,
  image = 'https://heenatsalma.earth/wp-content/uploads/2024/04/dsc00685_sm.webp',
  class: extraClass = '',
} = Astro.props;
---

<section
  class={['event-space', extraClass].filter(Boolean).join(' ')}
  style={`--event-space-image: url(${image});`}
>
  <div class="container px-5">
    <div class="event-space__content mx-auto " data-aos="fade-right">
     <div class="border-start border-2 ps-2">
       <Tag variant="plain" tone="on-dark" class="">{eyebrow}</Tag>
      <h2 class="display-4 text-light">{heading}</h2>
     </div>
      <p class="mt-4 fs-3 fs-md-2 text-light mx-auto">{lead}</p>
      <Button variant="outline-light" href={ctaHref} class="mt-4">{ctaLabel}</Button>
    </div>
  </div>
</section>

<style>
  .event-space {
    position: relative;
    /* Scrim over the image (--event-space-image is set per instance above). */
    background-image:
      linear-gradient(rgba(var(--bs-scrim-rgb), 0.55), rgba(var(--bs-scrim-rgb), 0.55)),
      var(--event-space-image);
    background-size: auto;
    background-position: left 0 bottom 50%;
    background-repeat: repeat-x;
    background-attachment: fixed;
    padding-block: clamp(96px, 14vw, 160px);
   
  }

  /* iOS Safari never renders fixed backgrounds correctly, and repainting a
     fixed background on scroll is expensive on any touch device — scroll
     normally below desktop instead of faking the parallax. */
  @media (max-width: 991.98px), (hover: none) {
    .event-space {
      background-attachment: scroll;
    }
  }

  .event-space__content {
    max-width: 40rem;
  }

@media screen and (min-width: 768px) {
  .event-space{
    /* Animation attaches only when screen width is 768px or wider */
    animation: slideRight 20s linear infinite; 
  }
}

  @keyframes slideRight {
  0% {
    background-position: left 0 bottom 50%;
  }
  100% {
    /* Moving to a positive value pushes the background from left to right */
    background-position:left 100% bottom 50%; 
  }
}
</style>

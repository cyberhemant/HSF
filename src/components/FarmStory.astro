---
import Tag from "./Tag.astro";
import Button from "./Button.astro";
import Divider from "./Divider.astro";

import AnimatedOutlineButton from "./AnimatedOutlineButton.astro";
export interface Props {
  id?: string;
  eyebrow?: string;
  heading?: string;
  dropcap?: string;
  lead?: string;
  ctaLabel?: string;
  ctaHref?: string;
  mapimage?: { src: string; alt: string };
  stats?: { value: string; label: string }[];
  class?: string;
}

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const {
  id = "story-section",
  eyebrow = "Farm Story",
  heading = "The Story of the Farm",
  // Set apart as a drop cap; `lead` continues the sentence from it.
  dropcap = "It",
  ctaLabel = "Discover Our Story",
  ctaHref = `${base}/about/`,
  lead = `began in 2019, when the Caravane Earth Foundation brought together a group of dedicated experts in agronomy, architecture, and water infrastructure to develop a holistic farm model and ten-year strategy aimed at converting a conventional farm into a centre for regenerative agriculture; driven by ethical approaches to agriculture, hospitality, education, and craftsmanship, Heenat Salma connects people with nature.`,
  mapimage = { src: `${base}/images/map.png`, alt: "Map of Heenat Salma Farm" },
  stats = [
    { value: "12", label: "Hectares" },
    { value: "70+", label: "Edible species" },
    { value: "0", label: "Synthetic inputs" },
  ],
  class: extraClass = "",
} = Astro.props;
---

<section class={["rip-section bg-sand py-7", extraClass].filter(Boolean).join(" ")} {id}>
  <div class="container-fluid">
    <div class="h-story-inner">
      <div class="row align-items-center">
        <div class="col-12 col-lg-7">
          <img
            data-aos="zoom-out"
            class="img-fluid d-block mx-auto"
            src={mapimage.src}
            alt={mapimage.alt}
          />
        </div>
        <div class="col-12 col-lg-4 reveal px-4">
          <Tag variant="plain" class="pb-3">{eyebrow}</Tag>
          <h2 class="display-5">{heading}</h2>

          <p class="py-4">
            <strong class="farm-story__dropcap display-3">{dropcap}</strong>
            {lead}
          </p>

          <AnimatedOutlineButton variant="outline-primary" arrow href={ctaHref}>
            {ctaLabel}
          </AnimatedOutlineButton>
          <Divider variant="palm" />

          <div class="d-flex justify-content-between gap-3">
            {stats.map((stat) => (
              <div>
                <div>
                  <span class="fs-1 lh-1">{stat.value}</span>
                </div>
                <div>
                  <span class="text-uppercase ls-tag text-ink-faint small">{stat.label}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .farm-story__dropcap {
    float: left;
    line-height: 0.74;
    margin: 6px 14px 0 0;
  }

  .rip-section {
    --edge: 30px; /* height of the torn edge – change to taste */
    position: relative;
    z-index: 1; /* sit above neighbours */

    /* overlap neighbours so they show through the torn gaps */
    margin-block: calc(var(--edge) * -1);

    /* Solid-black shapes: only the alpha channel matters for a mask.
         Swap these for url("torn-top.svg") / url("torn-bottom.svg") if you
         want to use your own artwork. */

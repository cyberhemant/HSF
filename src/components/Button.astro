---
// §4 Buttons — thin wrapper over Bootstrap's native btn/outline system.
// primary → btn-primary, outline-primary → btn-outline-primary (Bootstrap's
// own outline convention, which is exactly what we hand-built before),
// secondary → btn-outline-secondary, text → btn-link. light / outline-light
// are the inverted pair for dark or image backgrounds (Bootstrap's own
// btn-light / btn-outline-light, $light = cream).
export interface Props {
  variant?: 'primary' | 'outline-primary' | 'secondary' | 'text' | 'light' | 'outline-light';
  href?: string;
  disabled?: boolean;
  type?: 'button' | 'submit' | 'reset';
  class?: string;
}

const VARIANT_CLASS: Record<string, string> = {
  primary: 'btn-primary',
  'outline-primary': 'btn-outline-primary',
  secondary: 'btn-outline-secondary',
  text: 'btn-link text-decoration-underline',
  light: 'btn-light',
  'outline-light': 'btn-outline-light',
};

const {
  variant = 'primary',
  href,
  disabled = false,
  type = 'button',
  class: extraClass = '',
  ...rest
} = Astro.props;

const classes = [
  'btn',
  VARIANT_CLASS[variant],
  disabled ? 'disabled' : '',
  extraClass,
].filter(Boolean).join(' ');

const Tag = href && !disabled ? 'a' : 'button';
---

<Tag
  class={classes}
  href={href && !disabled ? href : undefined}
  type={Tag === 'button' ? type : undefined}
  disabled={Tag === 'button' && disabled ? true : undefined}
  aria-disabled={disabled ? 'true' : undefined}
  tabindex={Tag === 'a' && disabled ? -1 : undefined}
  {...rest}
>
  <slot />
</Tag>

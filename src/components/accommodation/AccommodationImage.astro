---
export interface Props {
  src: string;
  alt: string;
}

const { src, alt } = Astro.props;
---

<div class="acc-image">
  <img class="acc-image__img" src={src} alt={alt} loading="lazy" />
</div>

<style>
  .acc-image {
    overflow: hidden;
    border-radius: 4px;
    aspect-ratio: 4 / 3;
  }

  .acc-image__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .6s ease;
  }

  .acc-image:hover .acc-image__img,
  .acc-image:focus-within .acc-image__img {
    transform: scale(1.03);
  }

  @media (prefers-reduced-motion: reduce) {
    .acc-image__img {
      transition: none;
    }
  }
</style>

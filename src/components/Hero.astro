---
// Home page hero — DESIGN.md §4 example prompt 6: cream background,
// two-column layout (image left, text right on desktop; stacked on
// mobile), H1 in Alegreya 800 colored maroon, Paragraph 1 body copy,
// a Primary button below the copy. Heading defaults to the tagline used
// in the farm's own brand video ("where every visit becomes a memory"),
// kept in the Experiential voice register (§11): sensory, calm, sincere.
import Tag from './Tag.astro';
import Button from './Button.astro';
import Divider from './Divider.astro';
import Icon from './Icon.astro';
import AnimatedOutlineButton from './AnimatedOutlineButton.astro';
export interface Props {
  eyebrow?: string;
  heading?: string;
  lead?: string;
  ctaLabel?: string;
  ctaHref?: string;
  image?: { src: string; alt: string };
  ripimage?: { src: string; alt: string };
  mapimage?: { src: string; alt: string };
  hero_video?: { src: string };
  class?: string;
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const {
  eyebrow = 'Farm Story ',
  heading = 'Where every visit becomes a memory',
  lead = 'Heenat Salma is a working eco-farm and camp on the edge of the desert — a place to slow down, gather, and return to.',
  ctaLabel = 'Plan a Visit',
  ctaHref = '#',
  image = { src: `${base}/images/lodge-two.webp`, alt: 'An outdoor dining terrace overlooking the camp at Heenat Salma Farm' },
  ripimage = { src: `${base}/images/rip.svg`, alt: 'An outdoor dining terrace overlooking the camp at Heenat Salma Farm' },
  mapimage = { src: `${base}/images/map.png`, alt: 'Map of Heenat Salma Farm' },
  hero_video = {
    src: `${base}/images/hero_video.mp4#t=16,58`
    
  },
  class: extraClass = '',
} = Astro.props;
---
  <!-- <section class="featured-hero" aria-label="Featured experiments hero carousel">

 <div class="featured-hero__container">
        <div class="featured-hero__video">
          
               <video 
  poster={image.src}
  autoplay
  muted
  loop
  playsinline
>
  <source
          src={hero_video.src}
          type="video/mp4"
        />

  Your browser does not support the video tag.
</video>
        </div>
        <div class="featured-hero__gradient featured-hero__gradient--dark"></div>
        <div class="featured-hero__text-container">
          <div class="featured-hero__animation__text-container">
            <h1 class="text-light display-4">Where Nature, Culture & Community Come Together</h1>
            
            <a href="#" class="d-inline-block text-light" aria-label="Get started">
              <span>Experience the Farm</span>
              <br>
             
              
            </a>
             <span class="h-down-arrow"> 
                <Icon class="text-light" name="keyboard_double_arrow_down" size={48} /> 
                </span>
          </div>
        </div>
      </div>



  </section> -->
  <section class={['position-relative', extraClass].filter(Boolean).join(' ')}> 
    
    <!-- Video Background Container -->
      <div class="hero-video-background">
        <div
  style={`height: 50px;background-position: bottom; position: relative; top:calc(100% - 49px); z-index: 10;
    background-repeat: repeat-x;
    transform: scaleY(-1); background-image: url(${ripimage.src});`}
></div>
        <video 
  poster={image.src}
  autoplay
  muted
  loop
  playsinline
>
  <source
          src={hero_video.src}
          type="video/mp4"
        />

  Your browser does not support the video tag.
</video>
        <div class="hero-content">
    <h1 class="text-light display-4 hero-title">Where Nature, Culture & Community Come Together</h1>
            
            <a href="#story-section" class="fs-3 text-light pt-4 text-decoration-none" aria-label="Get started">
              <span>Experience the Farm</span>
              <br>
             <span class="h-down-arrow"> 
              <Icon class="text-light" name="keyboard_double_arrow_down" size={48} /> 
            </span>
            </a>
           
  </div>
        <!-- Dark Overlay for Contrast -->
        <div class="hero-video-overlay"></div>
      </div>
      <!-- Content Layer on top of video -->
  
  </section>
   
  <section class="bg-sand py-5" id="story-section">
   
   
    <div class="container-fluid">
      <div class="h-story-inner   ">
        <div class="row align-items-center "> 
          <div class="col-12 col-lg-7">
        
            
<img data-aos="zoom-out" class="img-fluid d-block mx-auto" data-aos="zoom-in" src={mapimage.src} alt={mapimage.alt} />


           
        

          </div>
          <div class="col-12 col-lg-4 reveal px-4">
           
        <Tag variant="plain" class='pb-3'>{eyebrow} </Tag>
              <h2 class=" display-5">The Story of the Farm</h2>
                 
              <p class="py-4">
            <strong class="display-3" style="float: left;   line-height: 0.74;   margin: 6px 14px 0px 0px;">It</strong>
                 began in 2019, when the Caravane Earth Foundation brought together a group of dedicated experts in agronomy, architecture, and water infrastructure to develop a holistic farm model and ten-year strategy aimed at converting a conventional farm into a centre for regenerative agriculture; driven by ethical approaches to agriculture, hospitality, education, and craftsmanship, Heenat Salma connects people with nature.
              </p>
            

              
              <AnimatedOutlineButton variant="outline-primary" arrow href="">Discover Our Story</AnimatedOutlineButton>
              <Divider variant="palm" />
         
              <div class="d-flex justify-content-between gap-3">
            
                  <div> 
                    <div>
                      <span style="font-size: 36px; line-height: 1;" >12</span>
                    </div>
                    <div>
                      <span class="text-uppercase ls-tag text-ink-faint small">Hectares</span>
                    </div>
                  </div>
                  <div> 
                    <div>
                      <span style="font-size: 36px; line-height: 1;" >70+</span>
                    </div>
                    <div>
                      <span class="text-uppercase ls-tag text-ink-faint small">Edible species</span>
                    </div>
                  </div>
                  <div> 
                    <div>
                      <span style="font-size: 36px; line-height: 1;" >0</span>
                    </div>
                    <div>
                      <span class="text-uppercase ls-tag text-ink-faint small">Synthetic inputs</span>
                    </div>
                  </div>
                  
                  
             
              </div>
          </div>
          
        </div>
      </div>
    </div>
 
  </section>



<style>




/* Container: Remove z-index: -1, use relative positioning */

@media (max-width: 768px) {
  .hero-title {
    font-size: 2.5rem; /* Adjust as needed for smaller screens */
  }
}

.hero-video-background {
  position: relative;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
}

/* Ensure video covers background */
.hero-video-background video {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: 0; /* Base video layer */
  transform: scale(1.5);
}

/* Semi-transparent dark overlay above video */
.hero-video-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1; /* Sits above video */
}

/* Content layout centered on top of everything */
.hero-content {
  position: relative;
  z-index: 2; /* Sits ABOVE overlay (z-index: 1) and video (z-index: 0) */
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  text-align: center;
  padding: 20px;
  color: #ffffff; /* Ensures text is visible against dark overlay */
  max-width: 800px;
      margin: 0 auto;
}





 /* .h-story-inner::after {
  content: "";
  height: 20px;
  display: block;
  background: url(https://s3-us-west-2.amazonaws.com/s.cdpn.io/3/rip.svg) bottom left;
  background-size: 100%;
  position: absolute;
  top: 100%;
  left: 0;
  width: 100%;
} */

.h-down-arrow {
  animation: pulse 2s infinite cubic-bezier(0.4, 0, 0.6, 1);
  will-change: transform;
  display: inline-block;
}

@keyframes pulse {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(10px);
  }
}



</style>

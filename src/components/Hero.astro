---
// Home page hero — DESIGN.md §4 example prompt 6: cream background,
// two-column layout (image left, text right on desktop; stacked on
// mobile), H1 in Alegreya 800 colored maroon, Paragraph 1 body copy,
// a Primary button below the copy. Heading defaults to the tagline used
// in the farm's own brand video ("where every visit becomes a memory"),
// kept in the Experiential voice register (§11): sensory, calm, sincere.

import Icon from "./Icon.astro";

export interface Props {
  heading?: string;
  ctaLabel?: string;
  ctaHref?: string;
  hero_video?: { src: string; poster?: string; type?: string };
  class?: string;
}

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const {
  heading = "Where Nature, Culture & Community Come Together",
  ctaLabel = "Experience The Farm",
  ctaHref = "#story-section",
  hero_video = {
    src: `${base}/images/hero_video.mp4#t=16,58`,
    poster: `${base}/images/lodge-two.webp`,
    type: "video/mp4",
  },
  class: extraClass = "",
} = Astro.props;
---

<section class:list={["position-relative", extraClass]}>
  <div class="hero-video-background">
    <video
      poster={hero_video.poster}
      autoplay
      muted
      loop
      playsinline
      aria-hidden="true"
    >
      <source src={hero_video.src} type={hero_video.type} />
    </video>

    <!-- Scrim for text contrast. Painted after the video and before the
         content, so DOM order alone stacks the three layers (no z-index). -->
    <div class="hero-video-overlay"></div>

    <div
      class="hero-content d-flex flex-column align-items-center justify-content-center text-center text-light p-4 mx-auto"
    >
      <h1 class="text-light display-4 hero-title">{heading}</h1>

      <a href={ctaHref} class="fs-3 text-light pt-4 text-decoration-none">
        <span>{ctaLabel}</span>
        <br />
        <span class="h-down-arrow">
          <Icon name="keyboard_double_arrow_down" size={48} />
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  .hero-video-background {
    position: relative;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
  }

  .hero-video-background video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.5);
  }

  .hero-video-overlay {
    position: absolute;
    inset: 0;
    background-color: rgba(var(--bs-black-rgb), 0.5);
  }

  .hero-content {
    position: relative;
    min-height: 100%;
    max-width: 800px;
  }

  @media (max-width: 767.98px) {
    .hero-title {
      font-size: 2.5rem;
    }
  }

  .h-down-arrow {
    display: inline-block;
    animation: pulse 2s infinite cubic-bezier(0.4, 0, 0.6, 1);
  }

  @keyframes pulse {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(10px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .h-down-arrow {
      animation: none;
    }
  }
</style>

---
// §4 Icons — utility/UI tier on Google Material Symbols (Outlined, variable
// weight dialed toward "Thin" per DESIGN.md). Pass any Material Symbols icon
// name (e.g. "menu", "chevron_right", "hotel") — browse the full set at
// fonts.google.com/icons. Social brand marks (facebook, instagram, tiktok,
// youtube, twitter, whatsapp, snapchat) render as Simple Icons SVGs instead:
// Material Symbols is a UI icon set, not a brand-logo library, and brand
// marks aren't in it. "twitter" maps to the current X logo.
import { BRAND_ICONS } from './brandIcons';

export interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 20, class: extraClass = '' } = Astro.props;
const symbol = name.replace(/-/g, '_');
const brand = BRAND_ICONS[name];
---

{brand ? (
  <svg class={extraClass} width={size} height={size} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={brand} />
) : (
  <span
    class={['material-symbols-outlined', extraClass].filter(Boolean).join(' ')}
    style={`--icon-size: ${size}px; font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' ${size};`}
    aria-hidden="true"
  >{symbol}</span>
)}

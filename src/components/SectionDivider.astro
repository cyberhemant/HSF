---
// §4 Dividers — "A thin horizontal rule (1px solid #DCD0C0) interrupted by a
// small diamond/geometric motif in ochre — a restrained nod to the Islamic
// geometric and kilim pattern language... used between major page sections
// only, never as a repeating background." Matches the example prompt in §9.
export interface Props {
  class?: string;
}

const { class: extraClass = '' } = Astro.props;
---

<div class={['section-divider', extraClass].filter(Boolean).join(' ')} role="presentation" aria-hidden="true">
  <span class="section-divider__line"></span>
  <svg class="section-divider__motif" width="18" height="18" viewBox="0 0 18 18" fill="none">
    <path d="M9 1 L17 9 L9 17 L1 9 Z" stroke="currentColor" stroke-width="1.25" />
    <path d="M9 6 L13 9 L9 13 L5 9 Z" stroke="currentColor" stroke-width="1.25" />
  </svg>
  <span class="section-divider__line"></span>
</div>

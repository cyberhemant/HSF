---
// Product-detail style gallery: one large stage image, prev/next arrows
// pinned to its bottom-right corner, and a row of square thumbnails below
// that scrolls horizontally once it outgrows the available width. On mobile
// the arrows and thumbnail strip give way to a row of dots under the stage.
// With a single image there is nothing to navigate, so the arrows, thumbnails
// and dots are not rendered at all — just the stage.
//
// `state` is owned by the parent (which knows whether the photos are being
// fetched or failed to load): 'ready' renders the images; 'loading' shows a
// skeleton of the stage and thumbnail row; 'empty' and 'error' replace the
// stage with a short message (override the copy with `message`). A 'ready'
// gallery given no images falls back to 'empty' rather than a blank stage.
// Responsive: only the thumbnail-row skeleton changes at `md` (hidden below,
// like the real thumbnails); the stage and messages do not change.
import Icon from './Icon.astro';

export interface Props {
  images?: { src: string; alt?: string }[];
  state?: 'ready' | 'loading' | 'empty' | 'error';
  message?: string;
  class?: string;
}

const {
  images = [],
  state = 'ready',
  message,
  class: extraClass = '',
} = Astro.props;

const resolvedState = state === 'ready' && images.length === 0 ? 'empty' : state;
const isReady = resolvedState === 'ready';
const hasMultiple = isReady && images.length > 1;
const statusMessage = message ?? (resolvedState === 'error'
  ? "Couldn't load photos."
  : 'No photos available.');
---

<div
  class={['product-gallery', extraClass].filter(Boolean).join(' ')}
  data-product-gallery
  data-count={isReady ? images.length : 0}
  data-state={resolvedState}
  aria-busy={resolvedState === 'loading' ? 'true' : undefined}
  tabindex={hasMultiple ? 0 : undefined}
>
  <div class="product-gallery__stage" class:list={[{ 'placeholder-glow': resolvedState === 'loading' }]}>
    {resolvedState === 'loading' && (
      <>
        <span class="placeholder product-gallery__skeleton" aria-hidden="true"></span>
        <span class="visually-hidden" role="status">Loading photos</span>
      </>
    )}

    {(resolvedState === 'empty' || resolvedState === 'error') && (
      <div
        class="product-gallery__message"
        role={resolvedState === 'error' ? 'alert' : 'status'}
      >
        <Icon name={resolvedState === 'error' ? 'broken-image' : 'image'} size={32} />
        <p class="product-gallery__message-text">{statusMessage}</p>
      </div>
    )}

    {isReady && images.map((image, i) => (
      <img
        class="product-gallery__image"
        class:list={[{ 'is-active': i === 0 }]}
        data-index={i}
        src={image.src}
        alt={image.alt || ''}
        loading={i === 0 ? 'eager' : 'lazy'}
      />
    ))}

    {hasMultiple && (
      <div class="product-gallery__arrows d-none d-md-flex">
        <button type="button" class="product-gallery__arrow" data-action="prev" aria-label="Previous image">
          <Icon name="chevron-left" size={24} />
        </button>
        <button type="button" class="product-gallery__arrow" data-action="next" aria-label="Next image">
          <Icon name="chevron-right" size={24} />
        </button>
      </div>
    )}
  </div>

  {resolvedState === 'loading' && (
    <div class="product-gallery__thumbs d-none d-md-flex placeholder-glow" aria-hidden="true">
      {[0, 1, 2, 3].map(() => (
        <span class="placeholder product-gallery__thumb-skeleton"></span>
      ))}
    </div>
  )}

  {hasMultiple && (
    <div class="product-gallery__thumbs d-none d-md-flex" data-role="thumbs">
      {images.map((image, i) => (
        <button
          type="button"
          class="product-gallery__thumb"
          class:list={[{ 'is-active': i === 0 }]}
          data-action="thumb"
          data-index={i}
          aria-label={`Show image ${i + 1}`}
          aria-current={i === 0 ? 'true' : 'false'}
        >
          <img src={image.src} alt="" loading="lazy" />
        </button>
      ))}
    </div>
  )}

  {hasMultiple && (
    <div class="product-gallery__dots d-flex d-md-none" role="tablist" aria-label="Select image">
      {images.map((_, i) => (
        <button
          type="button"
          class="product-gallery__dot"
          class:list={[{ 'is-active': i === 0 }]}
          data-action="dot"
          data-index={i}
          aria-label={`Go to image ${i + 1}`}
          aria-current={i === 0 ? 'true' : 'false'}
        ></button>
      ))}
    </div>
  )}
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-product-gallery]').forEach((root) => {
    const count = Number(root.dataset.count) || 0;
    // Nothing to navigate with 0–1 images: no controls are rendered, so skip
    // wiring up keyboard and swipe handling too.
    if (count < 2) return;

    const images = Array.from(root.querySelectorAll<HTMLImageElement>('.product-gallery__image'));
    const thumbs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-action="thumb"]'));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-action="dot"]'));
    const thumbsWrap = root.querySelector<HTMLElement>('[data-role="thumbs"]');

    let current = 0;

    const show = (index: number) => {
      current = ((index % count) + count) % count;

      images.forEach((img, i) => {
        img.classList.toggle('is-active', i === current);
        // Every image not currently active sits off-canvas to the left or
        // right based purely on its index vs. current — no direction
        // tracking needed. Whichever way `current` moves, the CSS
        // transition on transform carries it across in the right direction.
        img.classList.toggle('is-prev', i < current);
      });

      thumbs.forEach((thumb, i) => {
        const active = i === current;
        thumb.classList.toggle('is-active', active);
        thumb.setAttribute('aria-current', String(active));
      });

      dots.forEach((dot, i) => {
        const active = i === current;
        dot.classList.toggle('is-active', active);
        dot.setAttribute('aria-current', String(active));
      });

      const activeThumb = thumbs[current];
      if (activeThumb && thumbsWrap) {
        const wrapRect = thumbsWrap.getBoundingClientRect();
        const thumbRect = activeThumb.getBoundingClientRect();
        if (thumbRect.left < wrapRect.left || thumbRect.right > wrapRect.right) {
          activeThumb.scrollIntoView({ behavior: 'smooth', inline: 'nearest', block: 'nearest' });
        }
      }
    };

    root.querySelector('[data-action="prev"]')?.addEventListener('click', () => show(current - 1));
    root.querySelector('[data-action="next"]')?.addEventListener('click', () => show(current + 1));
    thumbs.forEach((thumb, i) => thumb.addEventListener('click', () => show(i)));
    dots.forEach((dot, i) => dot.addEventListener('click', () => show(i)));

    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });

    // Swipe left/right on the stage — mobile only in practice (arrows take
    // over on desktop), but touch events fire regardless of viewport so
    // this doesn't need a media-query gate. passive: true throughout since
    // nothing here ever calls preventDefault — a mostly-vertical drag is
    // left alone to scroll the page as normal.
    const stage = root.querySelector<HTMLElement>('.product-gallery__stage');
    if (stage) {
      const SWIPE_THRESHOLD = 40;
      let startX = 0;
      let startY = 0;
      let tracking = false;

      stage.addEventListener('touchstart', (e) => {
        const touch = e.touches[0];
        startX = touch.clientX;
        startY = touch.clientY;
        tracking = true;
      }, { passive: true });

      stage.addEventListener('touchend', (e) => {
        if (!tracking) return;
        tracking = false;

        const touch = e.changedTouches[0];
        const dx = touch.clientX - startX;
        const dy = touch.clientY - startY;
        if (Math.abs(dx) < SWIPE_THRESHOLD || Math.abs(dx) < Math.abs(dy)) return;

        show(current + (dx < 0 ? 1 : -1));
      }, { passive: true });
    }
  });
</script>

<style>
  .product-gallery {
    outline: none;
  }

  .product-gallery__stage {
    position: relative;
    aspect-ratio: 1 / 1;
    background-color: var(--bs-beige);
    overflow: hidden;
  }

  .product-gallery__skeleton {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  .product-gallery__thumb-skeleton {
    flex: 0 0 auto;
    display: block;
    width: 5.5rem;
    height: 5.5rem;
  }

  .product-gallery__message {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: .5rem;
    padding: 1.5rem;
    text-align: center;
    color: var(--bs-ink-soft);
  }

  .product-gallery__message-text {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .product-gallery__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    z-index: 1;
    /* Default (unset) position is off-canvas right — .is-prev below moves
       anything behind the active index off-canvas left instead. */
    transform: translateX(100%);
    transition: transform .4s ease;
    pointer-events: none;
  }

  .product-gallery__image.is-active {
    transform: translateX(0);
    z-index: 2;
  }

  .product-gallery__image.is-prev {
    transform: translateX(-100%);
  }

  @media (prefers-reduced-motion: reduce) {
    .product-gallery__image {
      transition: none;
    }
  }

  .product-gallery__arrows {
    position: absolute;
    inset-block-end: 1rem;
    inset-inline-end: 1rem;
    z-index: 3;
    gap: .5rem;
  }

  .product-gallery__arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    background-color: #fff;
    color: var(--bs-ink-soft);
    border: none;
    /* border-radius: var(--bs-border-radius); */
    cursor: pointer;
    transition: color .2s ease;
  }

  .product-gallery__arrow:hover,
  .product-gallery__arrow:focus-visible {
    color: var(--bs-maroon);
  }

  .product-gallery__thumbs {
    gap: .75rem;
    margin-block-start: 1rem;
    padding-block-end: .25rem;
    overflow-x: auto;
    scrollbar-width: thin;
  }

  .product-gallery__thumb {
    flex: 0 0 auto;
    width: 5.5rem;
    height: 5.5rem;
    padding: 0;
    background: none;
    border: 2px solid transparent;
    /* border-radius: var(--bs-border-radius); */
    overflow: hidden;
    cursor: pointer;
    transition: border-color .2s ease;
  }

  .product-gallery__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: .6;
  }

  .product-gallery__thumb:hover img {
    opacity: 1;
  }

  
  .product-gallery__thumb.is-active img {
    opacity: 1;
  
  }

  .product-gallery__dots {
    justify-content: center;
    align-items: center;
    gap: .5rem;
    margin-block-start: 1rem;
  }

  .product-gallery__dot {
    width: .5rem;
    height: .5rem;
    padding: 0;
    background-color: var(--bs-border-color);
    border: none;
    border-radius: 50%;
    cursor: pointer;
    transition: background-color .2s ease, transform .2s ease;
  }

  .product-gallery__dot.is-active {
    background-color: var(--bs-maroon);
    transform: scale(1.25);
  }
</style>

---
// §4 Tag / Badge — small taxonomy chips, e.g. "Now Booking". Square corners.
// `variant="rule"` is the left-rule badge; `tone` picks its colour.
// `tone="on-dark"` is the inverted form of every variant, for dark surfaces.
// The other tones only apply to `rule`.
export interface Props {
  variant?: 'outline' | 'filled' | 'plain' | 'rule';
  tone?: 'neutral' | 'muted' | 'success' | 'danger' | 'on-dark';
  class?: string;
}

const { variant = 'outline', tone = 'neutral', class: extraClass = '' } = Astro.props;
const onDark = tone === 'on-dark';
const variantClass = variant === 'filled'
  ? (onDark ? 'bg-black bg-opacity-50 text-cream' : 'bg-beige text-maroon')
  : variant === 'plain'
  ? `bg-transparent border-0 p-0 ${onDark ? 'text-cream' : 'text-ochre-deep'}`
  : `bg-transparent border ${onDark ? 'text-cream border-cream' : 'text-ochre-deep'}`;

const classes = (variant === 'rule'
  ? ['tag-rule', tone !== 'neutral' && `tag-rule--${tone}`, extraClass]
  : ['badge', 'text-uppercase', 'ls-tag', variantClass, extraClass]
).filter(Boolean).join(' ');
---

<span class={classes}><slot /></span>

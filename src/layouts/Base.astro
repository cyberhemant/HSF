---
export interface Props {
  title: string;
  description?: string;
  version?: 'v1' | 'v2' | null;
}

const {
  title,
  description = 'Heenat Salma Farm — a working farm and retreat in Oman.',
  version = null,
} = Astro.props;

const base = import.meta.env.BASE_URL;
---

<html lang="en" data-version={version}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Alegreya:ital,wght@0,500;0,700;0,800;1,500&family=Alegreya+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap"
    />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot name="header" />
    <main id="main">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>

<style lang="scss" is:global>
  @use '../styles/main.scss';

  .skip-link {
    position: absolute;
    inset-inline-start: var(--space-3);
    inset-block-start: -100%;
    z-index: 100;
    background-color: var(--maroon);
    color: var(--white);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-button);
    text-decoration: none;

    &:focus {
      inset-block-start: var(--space-3);
      color: var(--white);
    }
  }
</style>

---
import Header from '../components/Header.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  favicon?: string;
  version?: 'v1' | 'v2' | null;
}

const {
  title,
  description = 'Discover Heenat Salma Farm: sustainable farming, artisanal workshops, organic dining, and serene retreats. Embrace eco-friendly living today!',
  image = '/images/color-hsf-logo.png',
  favicon = '/favicon.webp',
  version = null,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://heenatsalma.earth/');
const ogImageURL = new URL(`${base}${image}`, Astro.site ?? 'https://heenatsalma.earth/');
const faviconHref = `${base}${favicon}`;
const faviconType = favicon.endsWith('.png') ? 'image/png' : 'image/webp';
---

<html lang="en" data-version={version}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href={faviconHref} type={faviconType} />
    <link rel="apple-touch-icon" href={faviconHref} />

    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Heenat Salma Farm" />
    <meta property="og:image" content={ogImageURL} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Alegreya:ital,wght@0,500;0,700;0,800;1,500&family=Alegreya+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=block"
    />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot name="header">
      <Header />
      <Nav />
    </slot>
    <main id="main">
      <slot />
    </main>
    <slot name="footer">
      <Footer />
    </slot>
    <script src="../scripts/bootstrap.js"></script>
    <script src="../scripts/reveal.js"></script>
    <script src="../scripts/header-scroll.js"></script>
  </body>
</html>

<style lang="scss" is:global>
  @use '../styles/main.scss';
</style>

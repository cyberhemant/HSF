---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Tag from '../components/Tag.astro';

const base = import.meta.env.BASE_URL;

// Contrast ratios are from DESIGN.md §2 — measured, not estimated.
const palette = [
  { group: 'Primary', swatches: [
    { name: 'Maroon', token: '--maroon', hex: '#491010', note: 'Headings, primary button fill', ratios: '14.4:1 cream · 15.4:1 white · 10.9:1 beige', pass: 'AAA' },
    { name: 'Ochre', token: '--ochre', hex: '#A6885D', note: 'Icons, hairlines, dividers only', ratios: '3.1:1 cream · 3.3:1 white · 2.4:1 beige', pass: 'FAIL as text' },
    { name: 'Ochre Deep', token: '--ochre-deep', hex: '#8B6F45', note: 'The text-safe ochre', ratios: 'Use wherever ochre must carry words', pass: 'AA' },
  ]},
  { group: 'Surface', swatches: [
    { name: 'Cream', token: '--cream', hex: '#F9F7F5', note: 'Page canvas — 70–80% of layout by area', ratios: '—', pass: '' },
    { name: 'White', token: '--white', hex: '#FFFFFF', note: 'Card and panel surface', ratios: '—', pass: '' },
    { name: 'Beige', token: '--beige', hex: '#E0D8CF', note: 'Section washes', ratios: 'White text on beige = 1.4:1', pass: 'NEVER with white text' },
    { name: 'Border', token: '--border', hex: '#DCD0C0', note: 'Standard hairline', ratios: '—', pass: '' },
  ]},
  { group: 'Text', swatches: [
    { name: 'Ink', token: '--ink', hex: '#491010', note: 'Headings only', ratios: '14.4:1 on cream', pass: 'AAA' },
    { name: 'Ink Soft', token: '--ink-soft', hex: '#6B3226', note: 'DEFAULT body copy — never full maroon', ratios: '9.1:1 on cream', pass: 'AAA' },
    { name: 'Ink Faint', token: '--ink-faint', hex: '#9C8574', note: 'Metadata, captions, disabled', ratios: '3.4:1 on cream', pass: 'Large text only' },
  ]},
  { group: 'Semantic', swatches: [
    { name: 'Error', token: '--error', hex: '#A63B2A', note: 'Validation, destructive', ratios: '6.0:1 cream · 6.4:1 white', pass: 'AA' },
    { name: 'Success', token: '--success', hex: '#5B6E3A', note: 'Confirmation, valid field', ratios: '5.3:1 cream · 5.6:1 white', pass: 'AA' },
  ]},
];

const typeRamp = [
  { role: 'H1',            cls: 't-h1',       size: '2.1rem / 33.6px',  weight: '800', lh: '1.1',  face: 'Alegreya' },
  { role: 'H2',            cls: 't-h2',       size: '1.55rem / 24.8px', weight: '700', lh: '1.2',  face: 'Alegreya' },
  { role: 'H3 (derived)',  cls: 't-h3',       size: '1.25rem / 20px',   weight: '700', lh: '1.3',  face: 'Alegreya' },
  { role: 'H4 (derived)',  cls: 't-h4',       size: '1.06rem / 17px',   weight: '600', lh: '1.4',  face: 'Alegreya Sans' },
  { role: 'Tag',           cls: 't-tag',      size: '0.72rem / 11.5px', weight: '600', lh: '1.0',  face: 'Alegreya Sans' },
  { role: 'Caption',       cls: 't-caption',  size: '0.82rem / 13.1px', weight: '500', lh: '1.4',  face: 'Alegreya Sans' },
  { role: 'Paragraph 1',   cls: 't-p1',       size: '1.06rem / 17px',   weight: '400', lh: '1.7',  face: 'Alegreya Sans' },
  { role: 'Paragraph 2',   cls: 't-p2',       size: '0.92rem / 14.7px', weight: '400', lh: '1.65', face: 'Alegreya Sans' },
  { role: 'Quote',         cls: 't-quote',    size: '1.1rem italic',    weight: '500', lh: '1.5',  face: 'Alegreya' },
];

const spacing = [
  { name: '--space-1', value: 4 }, { name: '--space-2', value: 8 },
  { name: '--space-3', value: 16 }, { name: '--space-4', value: 24 },
  { name: '--space-5', value: 32 }, { name: '--space-6', value: 48 },
  { name: '--space-7', value: 64 },
];

const radii = [
  { name: '--radius-button',  value: '3px',   use: 'Buttons — smaller than a consumer-app pill, by design' },
  { name: '--radius-field',   value: '4px',   use: 'Form fields' },
  { name: '--radius-card',    value: '6px',   use: 'Cards, panels' },
  { name: '--radius-callout', value: '2px',   use: 'Callout / quote blocks' },
  { name: '--radius-chip',    value: '999px', use: 'Small taxonomy chips ONLY' },
];
---

<Base title="Styleguide — Heenat Salma Farm" description="Component gallery and design tokens.">
  <div class="container sg">
    <header class="sg__masthead">
      <Tag>Design System</Tag>
      <h1>Heenat Salma Farm</h1>
      <p class="t-p1">
        Every value on this page comes from <code>DESIGN.md</code> and is defined once in
        <code>_tokens.scss</code>. No component contains a hex value.
      </p>
      <p><a href={base}>&larr; Back to versions</a></p>
    </header>

    <!-- ================= PALETTE ================= -->
    <section class="sg__section">
      <h2>Colour</h2>
      <p class="t-p2">
        Ratios are measured, from DESIGN.md §2. The two failures below are marked because they
        are the ones that recur in review.
      </p>

      {palette.map((g) => (
        <div class="sg__group">
          <h3>{g.group}</h3>
          <div class="sg__swatches">
            {g.swatches.map((s) => (
              <div class="sg__swatch">
                <div class="sg__chip" style={`background-color: var(${s.token})`}></div>
                <div class="sg__swatch-body">
                  <strong>{s.name}</strong>
                  <code>{s.hex}</code>
                  <span class="t-caption">{s.note}</span>
                  <span class="t-caption">{s.ratios}</span>
                  {s.pass && (
                    <span class={`sg__badge ${s.pass.includes('FAIL') || s.pass.includes('NEVER') ? 'sg__badge--fail' : 'sg__badge--pass'}`}>
                      {s.pass}
                    </span>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </section>

    <!-- ================= TYPE ================= -->
    <section class="sg__section">
      <h2>Typography</h2>
      <p class="t-p2">
        Serif carries the brand moment; sans carries function. Alegreya never runs at UI sizes;
        Alegreya Sans never carries a page title.
      </p>

      <div class="sg__ramp">
        {typeRamp.map((t) => (
          <div class="sg__ramp-row">
            <div class="sg__ramp-meta">
              <strong>{t.role}</strong>
              <span class="t-caption">{t.face}</span>
              <span class="t-caption">{t.size} · {t.weight} · {t.lh}</span>
            </div>
            <div class={`sg__ramp-sample ${t.cls}`}>
              The farm wakes before we do
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ================= BUTTONS ================= -->
    <section class="sg__section">
      <h2>Buttons</h2>
      <p class="t-p2">
        All five states from §4. Tab through them — every one must show the ochre focus ring.
      </p>

      <div class="sg__states">
        <div class="sg__state">
          <span class="t-caption">Primary — default / hover / active</span>
          <div class="sg__row">
            <Button variant="primary">Plan a visit</Button>
            <Button variant="primary" class="is-hover-demo">Plan a visit</Button>
          </div>
        </div>
        <div class="sg__state">
          <span class="t-caption">Primary — disabled</span>
          <div class="sg__row"><Button variant="primary" disabled>Plan a visit</Button></div>
        </div>
        <div class="sg__state">
          <span class="t-caption">Secondary</span>
          <div class="sg__row">
            <Button variant="secondary">Read the story</Button>
            <Button variant="secondary" disabled>Read the story</Button>
          </div>
        </div>
        <div class="sg__state">
          <span class="t-caption">Text button</span>
          <div class="sg__row">
            <Button variant="text">See all experiences</Button>
            <Button variant="text" disabled>See all experiences</Button>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= TAGS ================= -->
    <section class="sg__section">
      <h2>Tags</h2>
      <p class="t-p2">The one place a full-pill radius is permitted. Small taxonomy chips only.</p>
      <div class="sg__row">
        <Tag>Now Booking</Tag>
        <Tag>Seasonal</Tag>
        <Tag variant="filled">Wellness</Tag>
      </div>
    </section>

    <!-- ================= SPACING ================= -->
    <section class="sg__section">
      <h2>Spacing</h2>
      <p class="t-p2">
        16px is the default gap between related elements; 32–64px between distinct sections.
        Reach for spacing before reaching for a rule line.
      </p>
      <div class="sg__spacing">
        {spacing.map((s) => (
          <div class="sg__spacing-row">
            <code>{s.name}</code>
            <span class="t-caption">{s.value}px</span>
            <div class="sg__bar" style={`width: ${s.value}px`}></div>
          </div>
        ))}
      </div>
    </section>

    <!-- ================= RADIUS ================= -->
    <section class="sg__section">
      <h2>Radius</h2>
      <div class="sg__radii">
        {radii.map((r) => (
          <div class="sg__radius">
            <div class="sg__radius-box" style={`border-radius: var(${r.name})`}></div>
            <code>{r.name}</code>
            <span class="t-caption">{r.value}</span>
            <span class="t-caption">{r.use}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- ================= ELEVATION ================= -->
    <section class="sg__section">
      <h2>Elevation</h2>
      <p class="t-p2">
        Flat by default. The card shadow is the only elevation token in the system — the print
        guidelines show no drop shadows anywhere.
      </p>
      <div class="sg__row">
        <div class="sg__card">
          <strong>Content Card</strong>
          <span class="t-caption">White surface · 1px border · 6px radius · whisper-soft shadow</span>
        </div>
      </div>
    </section>
  </div>
</Base>

<style lang="scss">
  @use '../styles/foundation/breakpoints' as bp;

  .sg {
    padding-block: var(--space-7) var(--space-7);
  }

  .sg__masthead {
    padding-block-end: var(--space-6);
    border-block-end: 1px solid var(--border);

    > * + * { margin-block-start: var(--space-3); }
  }

  .sg__section {
    padding-block: var(--space-7);
    border-block-end: 1px solid var(--border);

    > * + * { margin-block-start: var(--space-4); }
  }

  .sg__group + .sg__group { margin-block-start: var(--space-5); }

  .sg__swatches {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
    margin-block-start: var(--space-3);

    @include bp.from(bp.$tablet) { grid-template-columns: repeat(2, 1fr); }
    @include bp.from(bp.$desktop) { grid-template-columns: repeat(3, 1fr); }
  }

  .sg__swatch {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    background-color: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    padding: var(--space-3);
  }

  .sg__chip {
    inline-size: 48px;
    block-size: 48px;
    border-radius: var(--radius-field);
    border: 1px solid var(--border);
    flex-shrink: 0;
  }

  .sg__swatch-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-inline-size: 0;
  }

  .sg__badge {
    align-self: flex-start;
    font-size: var(--size-tag);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-callout);
    margin-block-start: var(--space-1);
  }

  .sg__badge--pass { background-color: var(--success); color: var(--white); }
  .sg__badge--fail { background-color: var(--error);   color: var(--white); }

  .sg__ramp-row {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-4);
    border-block-start: 1px solid var(--border);

    @include bp.from(bp.$tablet) {
      grid-template-columns: 220px 1fr;
      gap: var(--space-5);
      align-items: baseline;
    }
  }

  .sg__ramp-meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .sg__states {
    display: grid;
    gap: var(--space-5);
  }

  .sg__state {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .sg__row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
  }

  .sg__spacing-row {
    display: grid;
    grid-template-columns: 130px 60px 1fr;
    gap: var(--space-3);
    align-items: center;
    padding-block: var(--space-2);
  }

  .sg__bar {
    block-size: 16px;
    background-color: var(--ochre);
    border-radius: var(--radius-callout);
  }

  .sg__radii {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: var(--space-4);
  }

  .sg__radius {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .sg__radius-box {
    inline-size: 100%;
    block-size: 64px;
    background-color: var(--beige);
    border: 1px solid var(--border);
    margin-block-end: var(--space-2);
  }

  .sg__card {
    background-color: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    max-inline-size: 320px;
  }

  code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.85em;
    color: var(--ochre-deep);
  }
</style>

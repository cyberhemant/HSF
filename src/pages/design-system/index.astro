        <!-- ================= TOASTS ================= -->
        <section id="toasts" class="pb-6 mb-6 border-bottom">
          <h2>Toasts</h2>
          <p class="text-ink-soft">
            Bootstrap's native Toast. Two forms: the default, with a header, and the themed toast
            below, created on demand with <code>showToast()</code>.
          </p>
          <button type="button" class="btn btn-outline-primary mt-3" id="ds-toast-trigger">Show default toast</button>
          <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1080;">
            <div id="ds-toast" class="toast bg-cream border-0" role="status" aria-live="polite" aria-atomic="true">
              <div class="toast-header bg-cream">
                <strong class="me-auto">Heenat Salma Farm</strong>
                <small class="text-ink-faint">just now</small>
                <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
              </div>
              <div class="toast-body">Your booking request was sent.</div>
            </div>
          </div>

          <h3 class="h5 mt-5">Themed toast</h3>
          <p class="text-ink-soft">
            <code>import &#123; showToast &#125; from '../scripts/toast.js'</code>. Only <code>body</code> is
            required. Every toast has its own id, timer and <code>onClose</code>, and toasts in the same
            position stack.
          </p>
          <ul class="text-ink-soft small">
            <li><code>theme</code> <code>info | success | warning | error</code> — sets the border, icon colour and default icon (<code>chat_info</code>, <code>task_alt</code>, <code>warning</code>, <code>error</code>). Default <code>info</code>.</li>
            <li><code>icon</code> — any Material Symbols name; replaces the theme icon.</li>
            <li><code>position</code> <code>top-start | top-center | top-end | bottom-start | bottom-center | bottom-end</code>. Default <code>top-center</code>.</li>
            <li><code>autoHide</code> (<code>true</code>) and <code>duration</code> (<code>3000</code> ms). The timer pauses while the toast is hovered or focused.</li>
            <li><code>dismissible</code> (<code>true</code>) — renders the close button.</li>
            <li><code>linkLabel</code>, <code>linkUrl</code>, <code>linkTarget</code> (<code>_self | _blank</code>) — the link renders only when both label and URL are given.</li>
            <li><code>action</code> — <code>&#123; label, onClick &#125;</code>: a button beside the message for a follow-up the guest can run there (e.g. Retry). Clicking runs <code>onClick</code>, then closes the toast. Omitted unless both are given; it can be combined with a link. Pair it with <code>autoHide: false</code> so it doesn't vanish before it is used.</li>
            <li><code>id</code> — optional; generated when omitted. <code>onClose</code> — called once the toast has fully closed, whether it timed out or was dismissed.</li>
          </ul>

          {toastDemos.map((g) => (
            <>
              <h4 class="h6 mt-4">{g.group}</h4>
              <div class="d-flex flex-wrap gap-2">
                {g.items.map((item) => (
                  <button type="button" class="btn btn-outline-secondary btn-sm" data-toast={JSON.stringify(item.toast)}>{item.label}</button>
                ))}
              </div>
            </>
          ))}

          <h4 class="h6 mt-4">Action</h4>
          <button type="button" class="btn btn-outline-secondary btn-sm" id="ds-toast-action">With action (Retry)</button>

          <h4 class="h6 mt-4">Stacking</h4>
          <button type="button" class="btn btn-outline-secondary btn-sm" id="ds-toast-stack">Show all four themes</button>
          <p class="small text-ink-soft mt-3 mb-0">
            <code>onClose</code> log: <span id="ds-toast-log">nothing closed yet</span>
          </p>
        </section>


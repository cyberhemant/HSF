              ]}
            />
          </div>
          <p class="text-ink-soft mt-4 mb-0">Loading</p>
          <div class="mt-2" style="max-width: 32rem;">
            <ProductGallery state="loading" />
          </div>
          <p class="text-ink-soft mt-4 mb-0">Empty</p>
          <div class="mt-2" style="max-width: 32rem;">
            <ProductGallery state="empty" />
          </div>
          <p class="text-ink-soft mt-4 mb-0">Error</p>
          <div class="mt-2" style="max-width: 32rem;">
            <ProductGallery state="error" />
          </div>
        </section>

        <!-- ================= ARCH CAROUSEL ================= -->
        <section id="arch-carousel" class="pb-6 mb-6 border-bottom">
          <h2>Arch Carousel</h2>
          <p class="text-ink-soft">
            The pointed-arch photo frame from the Stay and Kitchen promo sections: a
            Bootstrap carousel with the arch mask on each slide, autoplay and swipe.
            Prev/next arrows fade in on hover or keyboard focus; dots are always visible.
            <code>id</code> is required and must be unique on the page; <code>label</code>
            names the carousel for assistive tech. With a single image the arrows and dots
            are not rendered; with no images an empty beige arch holds the layout. The
            frame scales to its column up to 30rem and does not change at <code>md</code>.
          </p>
          <div class="row g-4 mt-2">
            <div class="col-md-4">
              <p class="text-ink-soft mb-2">Multiple images</p>
              <ArchCarousel
                id="ds-arch-carousel"
                images={[
                  { src: `${base}/images/lodge-two.webp`, alt: 'An outdoor terrace at Heenat Salma Farm' },
                  { src: `${base}/images/lodge-one.webp`, alt: 'Lodge One at Heenat Salma Farm' },
                  { src: `${base}/images/lodge-three.webp`, alt: 'Lodge Three at Heenat Salma Farm' },
                ]}
              />
            </div>
            <div class="col-md-4">
              <p class="text-ink-soft mb-2">Single image</p>
              <ArchCarousel
                id="ds-arch-carousel-single"
                images={[{ src: `${base}/images/lodge-one.webp`, alt: 'Lodge One at Heenat Salma Farm' }]}
              />
            </div>
            <div class="col-md-4">
              <p class="text-ink-soft mb-2">Empty</p>
              <ArchCarousel id="ds-arch-carousel-empty" />
            </div>
          </div>
        </section>

        <!-- ================= PLACEHOLDERS ================= -->
        <section id="placeholders" class="pb-6 mb-6 border-bottom">
          <h2>Placeholders</h2>
          <p class="text-ink-soft">Loading-state skeletons, for content still being fetched.</p>
          <div class="card mt-3" style="max-width: 24rem;" aria-hidden="true">
            <div class="card-body placeholder-glow">
              <h3 class="h5 card-title placeholder col-6"></h3>
              <p class="card-text">
                <span class="placeholder col-7"></span>
                <span class="placeholder col-4"></span>
                <span class="placeholder col-4"></span>
                <span class="placeholder col-6"></span>
              </p>
              <span class="btn btn-primary disabled placeholder col-4"></span>
            </div>
          </div>
        </section>

        <!-- ================= CLOSE BUTTON ================= -->
        <section id="close-button" class="pb-6 mb-6 border-bottom">
          <h2>Close Button</h2>
          <div class="d-flex gap-3 align-items-center mt-3 p-3 bg-white border rounded-3" style="max-width: 16rem;">
            <span class="flex-grow-1 small">Dismissible row</span>
            <button type="button" class="btn-close" aria-label="Close"></button>
          </div>
        </section>

        <!-- ================= TABLES ================= -->
        <section id="tables" class="pb-6 mb-6 border-bottom">
          <h2>Tables</h2>
          <div class="table-responsive mt-3">
            <table class="table table-striped table-hover align-middle">
              <thead>
                <tr><th scope="col">Experience</th><th scope="col">Duration</th><th scope="col">Price</th></tr>
              </thead>
              <tbody>
                {experiences.map((e) => (
                  <tr>
                    <td>{e.name}</td>
                    <td>{e.duration}</td>
                    <td>{e.price}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <!-- ================= SCROLLSPY ================= -->
        <section id="scrollspy" class="pb-6 mb-6 border-bottom">
          <h2>Scrollspy</h2>
          <p class="text-ink-soft">A self-contained example (Bootstrap's own documented pattern) — scroll inside the box.</p>
          <div class="row mt-3">
            <div class="col-4">
              <nav id="ds-spy-nav" class="nav nav-pills flex-column">
                <a class="nav-link" href="#ds-spy-one">One</a>
                <a class="nav-link" href="#ds-spy-two">Two</a>
                <a class="nav-link" href="#ds-spy-three">Three</a>
              </nav>
            </div>
            <div class="col-8">
              <div
                data-bs-spy="scroll"
                data-bs-target="#ds-spy-nav"
                data-bs-smooth-scroll="true"
                tabindex="0"
                class="p-3 bg-white border rounded-3"
                style="height: 140px; overflow-y: scroll;"
              >
                <h4 id="ds-spy-one" class="h6">One</h4>
                <p class="small">Organic regenerative agriculture underpins everything the farm grows.</p>
                <h4 id="ds-spy-two" class="h6">Two</h4>
                <p class="small">The artisanal kitchen turns that harvest into meals for guests.</p>
                <h4 id="ds-spy-three" class="h6">Three</h4>
                <p class="small">And the lodges put guests in the middle of it, not beside it.</p>
              </div>
            </div>
          </div>
        </section>
      </div>
    </div>
  </div>
</Base>

<script>
  import { showToast } from '../../scripts/toast.js';
  import { getAutocomplete } from '../../scripts/autocomplete.js';
  import { getPhoneNumber } from '../../scripts/phone-number.js';
  import { getDateTimeSlotPicker } from '../../scripts/date-time-slot-picker.js';
  import { getDatePicker } from '../../scripts/date-picker.js';
  import { addDays, addMonths, daysInMonth, monthOf, todayISO } from '../../scripts/date-only.js';

  // Every demo toast reports its close to the log line, which shows onClose
  // firing per toast for both timeout and manual dismissal.
  const log = document.getElementById('ds-toast-log');
  const show = (options) => {
    const toast = showToast({
      ...options,
      onClose: () => {
        if (log) log.textContent = `"${options.body}" closed (${toast?.id})`;
      },
    });
  };

  document.querySelectorAll('[data-toast]').forEach((button) => {
    button.addEventListener('click', () => show(JSON.parse(button.dataset.toast)));
  });

  document.getElementById('ds-toast-action')?.addEventListener('click', () => {
    let toast;
    toast = showToast({
      body: "Couldn't load availability",
      theme: 'error',
      autoHide: false,
      action: { label: 'Retry', onClick: () => { if (log) log.textContent = `Retry clicked (${toast?.id})`; } },
    });
  });

  document.getElementById('ds-toast-stack')?.addEventListener('click', () => {
    ['info', 'success', 'warning', 'error'].forEach((theme) => {
      show({ body: `${theme[0].toUpperCase()}${theme.slice(1)} toast`, theme });
    });
  });

  // ---- Autocomplete demos ------------------------------------------------
  // The `id` prop lands on the input; events fire on the component root.
  const acRoot = (id) => document.getElementById(id)?.closest('[data-autocomplete]');
  const acLog = document.getElementById('ds-ac-log');
  document.addEventListener('autocomplete:change', (e) => {
    const { id } = e.target.querySelector('input');
    if (acLog) acLog.textContent = `${id}: ${JSON.stringify(e.detail.values)}`;
  });

  // ---- Phone Number demos ------------------------------------------------
  const phoneEl = (id) => document.getElementById(id)?.closest('[data-phone-number]');
  const phoneOut = document.getElementById('ds-ph-live-out');
  const showPhone = () => {
    const el = phoneEl('ds-ph-live');
    if (el && phoneOut) phoneOut.textContent = JSON.stringify(getPhoneNumber(el).getDetails());
  };
  phoneEl('ds-ph-live')?.addEventListener('phone-number:change', showPhone);
  document.getElementById('ds-ph-live-set')?.addEventListener('click', () => getPhoneNumber(phoneEl('ds-ph-live')).setValue('+919876543210'));
  document.getElementById('ds-ph-live-invalid')?.addEventListener('click', () => getPhoneNumber(phoneEl('ds-ph-live')).showInvalid());
  showPhone();

  // The required demo submits nowhere: it reports the form data instead.
  document.getElementById('ds-ph-form')?.addEventListener('submit', (e) => {
    const blocked = e.defaultPrevented; // the field rejected an empty or invalid number
    e.preventDefault();
    if (blocked) return;
    const out = document.getElementById('ds-ph-form-out');
    if (out) out.textContent = JSON.stringify(Object.fromEntries(new FormData(e.currentTarget)));
  });

  // Example 4 — a consumer-rendered message from the exposed limit state.
  const maxHint = document.getElementById('ds-ac-max-hint');
  acRoot('ds-ac-max')?.addEventListener('autocomplete:change', (e) => {
    const { limitReached, max, remaining } = e.detail;
    if (maxHint) maxHint.textContent = limitReached ? `Maximum ${max} selections reached.` : `You can select up to ${max} items (${remaining} left).`;
  });

  // Example 6 — a fake API: 700ms latency, optional failure.
  const directory = ['Alice Ndlovu', 'Amir Haddad', 'Ana Ribeiro', 'Bao Tran', 'Chen Wei', 'Chloe Martin', 'Dev Patel', 'Diego Alvarez', 'Elena Petrova', 'Farah Khan', 'Grace Okafor', 'Hiro Tanaka'];
  const remoteRoot = acRoot('ds-ac-remote');
  if (remoteRoot) {
    getAutocomplete(remoteRoot).setSource((query, { signal }) => new Promise((resolve, reject) => {
      const timer = setTimeout(() => {
        if (document.getElementById('ds-ac-fail')?.checked) {
          document.getElementById('ds-ac-fail').checked = false;
          reject(new Error('Simulated failure'));
          return;
        }
        const q = query.toLowerCase();
        resolve(directory.filter((n) => n.toLowerCase().includes(q)).map((n) => ({ value: n, label: n, secondaryLabel: 'Team' })));
      }, 700);
      signal.addEventListener('abort', () => { clearTimeout(timer); reject(new DOMException('Aborted', 'AbortError')); });
    }));
  }

  // The forced error state has no source to re-run; Try again just recovers it.
  acRoot('ds-ac-error')?.addEventListener('autocomplete:retry', () => {
    getAutocomplete(acRoot('ds-ac-error')).setState('ready');
  });

  // States form — submit is intercepted so the demo shows native validation.
  const acForm = document.getElementById('ds-ac-form');
  acForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const out = document.getElementById('ds-ac-form-out');
    const valid = acForm.checkValidity();
    if (out) out.textContent = valid ? `Submitted: ${new URLSearchParams(new FormData(acForm)).toString()}` : 'Not submitted — fix the highlighted field.';
  });

  // ---- Date & Time Slot Picker demos ------------------------------------
  const dtspLog = document.getElementById('ds-dtsp-log');
  document.addEventListener('dtsp:apply', (e) => {
    if (dtspLog) dtspLog.textContent = `${e.target.id}: apply — ${e.detail.display.combined}`;
  });
  document.addEventListener('dtsp:cancel', (e) => {
    if (dtspLog) dtspLog.textContent = `${e.target.id}: cancel`;
  });
  document.addEventListener('dtsp:datechange', (e) => {
    if (dtspLog) dtspLog.textContent = `${e.target.id}: datechange — ${e.detail.date}`;
  });

  // Example 1 — briefly shows the date-change skeleton (slots-only, never a
  // full-component spinner) on every date change. The availability for every
  // date was already loaded at hydration (it's a synchronous prop here), so
  // "loading" just needs to flip back — a real async caller would call
  // setAvailability(freshData) instead once its fetch resolves.
  const dtspModal = document.getElementById('ds-dtsp-modal');
  dtspModal?.addEventListener('dtsp:datechange', () => {
    const picker = getDateTimeSlotPicker(dtspModal);
    picker.setSlotsState('loading');
    setTimeout(() => picker.setSlotsState('ready'), 500);
  });

  // Example 3 — the recurring half of "disabled dates" (`isDateDisabled`
  // can't be a prop, see the component's own header comment): every Friday.
  const dtspDisabledDates = document.getElementById('ds-dtsp-disabled-dates');
  if (dtspDisabledDates) {
    getDateTimeSlotPicker(dtspDisabledDates).setDateDisabledRule((date) => new Date(`${date}T00:00:00`).getDay() === 5);
  }

  // States form — same "submit is intercepted" pattern as Autocomplete's.
  // Validity can't come from form.checkValidity(): the picker's value
  // carrier is a type="hidden" input, which the platform excludes from
  // constraint validation entirely (see the component's own comment on
  // handleFormSubmit) — so this checks the picker's committed value instead.
  const dtspForm = document.getElementById('ds-dtsp-form');
  const dtspRequiredEls = ['ds-dtsp-required', 'ds-dtsp-required-inline'].map((id) => document.getElementById(id));
  dtspForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const out = document.getElementById('ds-dtsp-form-out');
    const valid = dtspRequiredEls.every((el) => el && getDateTimeSlotPicker(el).getValue());
    if (out) out.textContent = valid ? `Submitted: ${new URLSearchParams(new FormData(dtspForm)).toString()}` : 'Not submitted — fix the highlighted field.';
  });
  // ---- Date Picker demos ----------------------------------------------------
  // Example 3's fake availability source: ~1s latency, every 5th day
  // unavailable, some days missing from the response (→ unknown), and the
  // month two ahead of today fails on its first request so Retry is reachable.
  const dpSourceEl = document.getElementById('ds-dp-source');
  if (dpSourceEl) {
    const failedOnce = new Set();
    const failingMonth = addMonths(monthOf(todayISO()), 2);
    getDatePicker(dpSourceEl).setSource((month) => new Promise((resolve, reject) => {
      setTimeout(() => {
        if (month === failingMonth && !failedOnce.has(month)) {
          failedOnce.add(month);
          reject(new Error('demo failure'));
          return;
        }
        const rows = {};
        for (let d = 1; d <= daysInMonth(month); d += 1) {
          const iso = `${month}-${String(d).padStart(2, '0')}`;
          if (d % 11 === 0) continue; // missing → unknown
          rows[iso] = d % 5 === 0 ? 'booked' : 'available';
        }
        resolve(rows);
      }, 1000);
    }));
  }

  const dpLog = document.getElementById('ds-dp-log');
  ['change', 'open', 'close', 'invalid'].forEach((name) => {
    document.addEventListener(`dp:${name}`, (e) => {
      const detail = e.detail ? ` — ${JSON.stringify(e.detail)}` : '';
      if (dpLog) dpLog.textContent = `${e.target.id}: ${name}${detail}`;
    });
  });

  const dpBasic = document.getElementById('ds-dp-basic');
  document.getElementById('ds-dp-set')?.addEventListener('click', () => getDatePicker(dpBasic).setValue(addDays(todayISO(), 7)));
  document.getElementById('ds-dp-clear')?.addEventListener('click', () => getDatePicker(dpBasic).clear());
  document.getElementById('ds-dp-disable')?.addEventListener('click', () => {
    const picker = getDatePicker(dpBasic);
    picker.setDisabled(!picker.disabled);
  });
</script>

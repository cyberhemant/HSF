---
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';
import AnimatedOutlineButton from '../../components/AnimatedOutlineButton.astro';
import IconButton from '../../components/IconButton.astro';
import NumericStepper from '../../components/NumericStepper.astro';
import Tag from '../../components/Tag.astro';
import Icon from '../../components/Icon.astro';
import Divider from '../../components/Divider.astro';
import PalmSpinner from '../../components/PalmSpinner.astro';
import ProductGallery from '../../components/ProductGallery.astro';
import ArchCarousel from '../../components/ArchCarousel.astro';
import Autocomplete from '../../components/Autocomplete.astro';
import PhoneNumber from '../../components/PhoneNumber.astro';
import DateTimeSlotPicker from '../../components/DateTimeSlotPicker.astro';
import DatePicker from '../../components/DatePicker.astro';
import { addDays as dpAddDays, todayISO as dpTodayISO } from '../../scripts/date-only.js';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const toc = [
  ['foundations-color', 'Colors'],
  ['foundations-typography', 'Typography'],
  ['foundations-spacing', 'Spacing & Radius'],
  ['buttons', 'Buttons'],
  ['icon-buttons', 'Icon Buttons'],
  ['button-group', 'Button Group'],
  ['numeric-stepper', 'Numeric Stepper'],
  ['badges', 'Badges / Tags'],
  ['dividers', 'Dividers'],
  ['forms', 'Forms'],
  ['autocomplete', 'Autocomplete'],
  ['phone-number', 'Phone Number'],
  ['date-time-slot-picker', 'Date & Time Slot Picker'],
  ['date-picker', 'Date Picker'],
  ['navs-tabs', 'Navs & Tabs'],
  ['navbar-offcanvas', 'Navbar & Offcanvas'],
  ['cards', 'Cards'],
  ['alerts', 'Alerts'],
  ['breadcrumb', 'Breadcrumb'],
  ['pagination', 'Pagination'],
  ['list-group', 'List Group'],
  ['progress', 'Progress'],
  ['spinners', 'Spinners'],
  ['accordion', 'Accordion'],
  ['dropdowns', 'Dropdowns'],
  ['modal', 'Modal'],
  ['toasts', 'Toasts'],
  ['tooltips-popovers', 'Tooltips & Popovers'],
  ['carousel', 'Carousel'],
  ['product-gallery', 'Product Gallery'],
  ['arch-carousel', 'Arch Carousel'],
  ['placeholders', 'Placeholders'],
  ['close-button', 'Close Button'],
  ['tables', 'Tables'],
  ['scrollspy', 'Scrollspy'],
];

// ---- Date Picker demo data ---------------------------------------------
// Dates are computed from the same Muscat-anchored todayISO() the component
// uses, via date-only.js's integer day arithmetic (no Date objects).
const dpToday = dpTodayISO();
const dpPreset = dpAddDays(dpToday, 10);
const dpBlackouts = [1, 2, 3].map((n) => dpAddDays(dpToday, n));
const dpMin = dpToday;
const dpMax = dpAddDays(dpToday, 14);
const dpFarMax = dpAddDays(dpToday, 365 * 4);

// ---- Date & Time Slot Picker demo data -------------------------------
// A fake availability source covering the default 30-day window — one
// closed date (no slots) and one fully booked date, so both date-level
// states are reachable without a real API, same approach the deleted
// date-range picker's demo used ("fake availability source").
const dtspPad2 = (n) => String(n).padStart(2, '0');
const dtspIsoOffset = (n) => {
  const d = new Date();
  d.setDate(d.getDate() + n);
  return `${d.getFullYear()}-${dtspPad2(d.getMonth() + 1)}-${dtspPad2(d.getDate())}`;
};
const DTSP_SLOT_TIMES = [
  '08:00', '08:30', '09:00', '09:30', '10:00', '10:30', '11:00',
  '12:00', '12:30', '13:00', '13:30', '14:00', '15:00', '15:30', '16:00',
  '17:00', '17:30', '18:00', '18:30', '19:00', '19:30',
];
const dtspMakeSlots = (dayOffset, bookedTimes: string[] = []) => DTSP_SLOT_TIMES.map((time) => ({
  id: `d${dayOffset}-${time.replace(':', '')}`,
  time,
  label: time,
  status: bookedTimes.includes(time) ? 'booked' as const : 'available' as const,
}));
const dtspAvailability = Array.from({ length: 31 }, (_, i) => {
  const date = dtspIsoOffset(i);
  if (i === 3) return { date, status: 'closed' as const, slots: [] };
  if (i === 5) return { date, status: 'full' as const, slots: dtspMakeSlots(i, DTSP_SLOT_TIMES) };
  const bookedTimes = DTSP_SLOT_TIMES.filter((_, idx) => idx % 5 === i % 5).slice(0, 3);
  return { date, status: 'available' as const, slots: dtspMakeSlots(i, bookedTimes) };
});
// One explicit holiday blackout (disabledDates) for the "disabled dates" demo —
// the weekly closure on that same demo comes from isDateDisabled, wired in the
// <script> below via setDateDisabledRule (it can't be a prop — see the
// component's own header comment).
const dtspHoliday = dtspIsoOffset(6);

const BOOKING = 'Your booking request was sent.';
const toastDemos = [
  { group: 'Themes', items: [
    { label: 'Info (default)', toast: { body: BOOKING } },
    { label: 'Success', toast: { body: BOOKING, theme: 'success' } },
    { label: 'Warning', toast: { body: 'Some experiences are weather-dependent this season.', theme: 'warning' } },
    { label: 'Error', toast: { body: 'That date is fully booked — try another week.', theme: 'error' } },
  ]},
  { group: 'Content & behaviour', items: [
    { label: 'Custom icon', toast: { body: BOOKING, theme: 'success', icon: 'favorite' } },
    { label: 'With link', toast: { body: BOOKING, theme: 'success', linkLabel: 'View booking', linkUrl: '/bookings/12345' } },
    { label: 'Link, new tab', toast: { body: BOOKING, linkLabel: 'View booking', linkUrl: 'https://example.com', linkTarget: '_blank' } },
    { label: 'Duration 6s', toast: { body: 'This stays for six seconds.', duration: 6000 } },
    { label: 'Persistent', toast: { body: 'Stays until you close it.', autoHide: false } },
    { label: 'Not dismissible', toast: { body: 'No close button — it hides itself.', dismissible: false } },
    { label: 'Long text', toast: { body: 'Your booking request for the Heenat Salma Farm lodge has been sent — the farm team will confirm availability by email within one working day.', autoHide: false } },
  ]},
  { group: 'Position', items: [
    'top-start', 'top-center', 'top-end', 'bottom-start', 'bottom-center', 'bottom-end',
  ].map((position) => ({ label: position, toast: { body: position, position } }))},
];

const flag = (code: string) => `${base}/flags/${code}.svg`;
const countries = [
  { value: 'in', label: 'India', secondaryLabel: '+91', image: flag('in'), popular: true, dialCode: '+91' },
  { value: 'us', label: 'United States', secondaryLabel: '+1', image: flag('us'), popular: true, dialCode: '+1' },
  { value: 'gb', label: 'United Kingdom', secondaryLabel: '+44', image: flag('gb'), popular: true, dialCode: '+44' },
  { value: 'ca', label: 'Canada', secondaryLabel: '+1', image: flag('ca'), disabled: true },
  { value: 'id', label: 'Indonesia', secondaryLabel: '+62', image: flag('id') },
  { value: 'ie', label: 'Ireland', secondaryLabel: '+353', image: flag('ie') },
  { value: 'it', label: 'Italy', secondaryLabel: '+39', image: flag('it') },
  { value: 'fr', label: 'France', secondaryLabel: '+33', image: flag('fr') },
  { value: 'de', label: 'Germany', secondaryLabel: '+49', image: flag('de') },
  { value: 'nl', label: 'Netherlands', secondaryLabel: '+31', image: flag('nl') },
  { value: 'jp', label: 'Japan', secondaryLabel: '+81', image: flag('jp') },
  { value: 'ae', label: 'United Arab Emirates', secondaryLabel: '+971', image: flag('ae') },
];
const plainCountries = countries.map(({ value, label, disabled }) => ({ value, label, disabled }));
// Nationality wording ("Indian", not "India") with the country name kept as a
// search keyword, so both "ind" and "india" find it.
const demonyms: Record<string, string> = {
  in: 'Indian', us: 'American', gb: 'British', ca: 'Canadian', id: 'Indonesian', ie: 'Irish',
  it: 'Italian', fr: 'French', de: 'German', nl: 'Dutch', jp: 'Japanese', ae: 'Emirati',
};
const nationalities = countries.map(({ value, label, image, disabled }) => ({
  value, label: demonyms[value], keywords: label, image, disabled,
}));
const acExperiences = [
  { value: 'walk', label: 'Sunrise Farm Walk', icon: 'hiking', secondaryLabel: '2 h' },
  { value: 'kitchen', label: 'Artisanal Kitchen Workshop', icon: 'skillet', secondaryLabel: '3 h' },
  { value: 'yoga', label: 'Morning Yoga', icon: 'self_improvement', secondaryLabel: '1 h' },
  { value: 'pottery', label: 'Pottery', icon: 'palette', secondaryLabel: '2 h' },
  { value: 'stargaze', label: 'Stargazing', icon: 'nightlight', secondaryLabel: '1.5 h' },
];

const colorGroups = [
  { group: 'Primary', swatches: [
    { name: 'Maroon', cls: 'primary', hex: '#491010', note: 'Headings, primary button fill. AAA everywhere.' },
    { name: 'Ochre', cls: 'ochre', hex: '#A6885D', note: 'Icons, hairlines, dividers ONLY — fails contrast as text.' },
    { name: 'Ochre Deep', cls: 'secondary', hex: '#8B6F45', note: 'The text-safe ochre (Bootstrap "secondary").' },
  ]},
  { group: 'Surface', swatches: [
    { name: 'Cream', cls: 'cream', hex: '#F9F7F5', note: 'Page canvas (Bootstrap "light").' },
    { name: 'Beige', cls: 'beige', hex: '#E0D8CF', note: 'Section washes, chip fill.' },
    { name: 'Sand', cls: 'sand', hex: '#EAE5D1', note: 'Proposed extension — warmer neutral wash, between cream and beige.' },
  ]},
  { group: 'Text', swatches: [
    { name: 'Ink Soft', cls: 'ink-soft', hex: '#6B3226', note: 'Default body copy.' },
    { name: 'Ink Faint', cls: 'ink-faint', hex: '#9C8574', note: 'Metadata, captions, disabled.' },
  ]},
  { group: 'Semantic', swatches: [
    { name: 'Danger', cls: 'danger', hex: '#A63B2A', note: 'Validation, destructive.' },
    { name: 'Success', cls: 'success', hex: '#5B6E3A', note: 'Confirmation, valid field.' },
    { name: 'Warning', cls: 'warning', hex: '#B9975B', note: 'Proposed extension — not in DESIGN.md’s 5-color palette.' },
    { name: 'Info', cls: 'info', hex: '#7C8B74', note: 'Proposed extension — muted sage, no foreign hue introduced.' },
  ]},
];

const displayRamp = [
  { role: 'Display 1', cls: 'display-1', size: '5rem / 300' },
  { role: 'Display 2', cls: 'display-2', size: '4.5rem / 300' },
  { role: 'Display 3', cls: 'display-3', size: '4rem / 300' },
  { role: 'Display 4', cls: 'display-4', size: '3.5rem / 300' },
  { role: 'Display 5', cls: 'display-5', size: '3rem / 300' },
  { role: 'Display 6', cls: 'display-6', size: '2.5rem / 300' },
];

const typeRamp = [
  { role: 'H1', el: 'h1', size: '2.1rem / 800 / 1.1' },
  { role: 'H2', el: 'h2', size: '1.55rem / 700 / 1.2' },
  { role: 'H3', el: 'h3', size: '1.25rem / 700 / 1.3' },
  { role: 'H4', el: 'h4', size: '1.06rem / 600 / 1.4' },
];

const spacing = [1, 2, 3, 4, 5, 6, 7];
const radii = [
  { name: 'rounded-1', use: 'Buttons, inputs — 3px, the family default' },
  { name: 'rounded-2', use: 'Callout / quote blocks — 2px' },
  { name: 'rounded-3', use: 'Cards, panels — 6px' },
  { name: 'rounded-pill', use: 'Circular Icon Buttons — the one full-pill radius' },
];

const experiences = [
  { name: 'Sunrise Farm Walk', duration: '90 min', price: 'OMR 12' },
  { name: 'Artisanal Kitchen Workshop', duration: '3 hrs', price: 'OMR 35' },
  { name: 'Wellness & Sound Bath', duration: '60 min', price: 'OMR 18' },
];
---

<Base  title="Design System — Heenat Salma Farm" description="Every Bootstrap component, themed to the brand.">
  <div class="container py-6">
    <header class="measure mb-6">
      <Tag>Design System</Tag>
      <h1 class="mt-3">Heenat Salma Farm</h1>
      <p class="mt-3 fs-5">
        Bootstrap 5.3, themed entirely through Sass variables and a thin custom layer from
        <code>DESIGN.md</code> — no component here carries a hand-picked one-off color. Every
        component Bootstrap ships is catalogued below in its themed state.
      </p>
      <p class="mt-2"><a href={base}>&larr; Back to versions</a></p>
    </header>

    <div class="row pt-6">
      <div class="col-lg-3 d-none d-lg-block">
        <nav class="nav nav-pills flex-column sticky-top" style="top: 3.5rem;">
          {toc.map(([id, label]) => (
            <a class="nav-link text-ink-soft" href={`#${id}`}>{label}</a>
          ))}
        </nav>
      </div>

      <div class="col-lg-9">
        <!-- ================= COLOR ================= -->
        <section id="foundations-color" class="pb-6 mb-6 border-bottom">
          <h2>Colors</h2>
          <p class="text-ink-soft">Every theme color, generated as <code>--bs-*</code> custom properties and <code>.bg-*</code> / <code>.text-*</code> / <code>.btn-*</code> utilities.</p>

          {colorGroups.map((g) => (
            <div class="mt-4">
              <h3 class="h5">{g.group}</h3>
              <div class="row g-3 mt-1">
                {g.swatches.map((s) => (
                  <div class="col-12 col-md-6 col-lg-4">
                    <div class="d-flex gap-3 align-items-start p-3 bg-white border rounded-3">
                      <div class={`bg-${s.cls} border rounded-2 flex-shrink-0`} style="width: 48px; height: 48px;"></div>
                      <div>
                        <strong class="d-block">{s.name}</strong>
                        <code class="small">{s.hex}</code>
                        <p class="small text-ink-faint mb-0">{s.note}</p>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </section>

        <!-- ================= TYPOGRAPHY ================= -->
        <section id="foundations-typography" class="pb-6 mb-6 border-bottom">
          <h2>Typography</h2>
          <p class="text-ink-soft">Alegreya (serif) carries the brand moment; Alegreya Sans carries function.</p>

          <h3 class="h4 mt-4">Display</h3>
          <p class="text-ink-soft">Bootstrap's stock display-1–display-6 — unweighted by the brief, so they inherit the serif heading font at Bootstrap's own light (300) weight.</p>

          {displayRamp.map((d) => (
            <div class="row py-3 border-top align-items-baseline">
              <div class="col-md-3">
                <strong>{d.role}</strong>
                <div class="small text-ink-faint">{d.size}</div>
              </div>
              <div class="col-md-9">
                <p class={`${d.cls} mb-0`}>The farm wakes</p>
              </div>
            </div>
          ))}

          <h3 class="h4 mt-5">Headings</h3>

          {typeRamp.map((t) => {
            const HeadingTag = t.el;
            return (
              <div class="row py-3 border-top align-items-baseline">
                <div class="col-md-3">
                  <strong>{t.role}</strong>
                  <div class="small text-ink-faint">{t.size}</div>
                </div>
                <div class="col-md-9">
                  <HeadingTag class="mb-0">The farm wakes before we do</HeadingTag>
                </div>
              </div>
            );
          })}

          <div class="row py-3 border-top align-items-baseline">
            <div class="col-md-3"><strong>Body / Link</strong></div>
            <div class="col-md-9">
              <p class="mb-1">Paragraph text runs at the base size with a <a href="#">text-button-style link</a> inline.</p>
              <a class="text-nav-link" href="#">Uppercase Nav Link</a>
            </div>
          </div>
        </section>

        <!-- ================= SPACING & RADIUS ================= -->
        <section id="foundations-spacing" class="pb-6 mb-6 border-bottom">
          <h2>Spacing &amp; Radius</h2>
          <p class="text-ink-soft">4–64px spacing scale (Bootstrap's spacer map, extended to keys 6–7); four radii, one of them a reserved full pill.</p>

          <div class="mt-4">
            {spacing.map((s) => (
              <div class="d-flex align-items-center gap-3 py-1">
                <code style="width: 2rem;">{s}</code>
                <div class={`bg-ochre p-${s}`} style="height: 16px;"></div>
              </div>
            ))}
          </div>

          <div class="row g-4 mt-4">
            {radii.map((r) => (
              <div class="col-6 col-md-3">
                <div class={`bg-beige border ${r.name}`} style="height: 64px;"></div>
                <code class="small d-block mt-2">{r.name}</code>
                <span class="small text-ink-faint">{r.use}</span>
              </div>
            ))}
          </div>
        </section>

        <!-- ================= BUTTONS ================= -->
        <section id="buttons" class="pb-6 mb-6 border-bottom">
          <h2>Buttons</h2>
          <p class="text-ink-soft">Bootstrap's native fill/outline/link tiers, tab through them for the themed ochre focus ring.</p>

          <div class="d-flex flex-wrap gap-3 align-items-center mt-3">
            <Button variant="primary">Plan a Visit</Button>
            <Button variant="outline-primary">Plan a Visit</Button>
            <Button variant="secondary">Read the Story</Button>
            <Button variant="text">See all Experiences</Button>
          </div>
          <div class="d-flex flex-wrap gap-3 align-items-center mt-3">
            <button class="btn btn-primary btn-lg">Large</button>
            <button class="btn btn-primary">Default</button>
            <button class="btn btn-primary btn-sm">Small</button>
            <Button variant="primary" disabled>Disabled</Button>
          </div>

          <h3 class="h5 mt-5">Inverted</h3>
          <p class="text-ink-soft">
            Bootstrap's native <code>btn-light</code> / <code>btn-outline-light</code> (<code>$light</code> is cream)
            for dark or image backgrounds. Pair with <code>text-light</code> for copy.
          </p>
          <div class="bg-primary p-4 d-flex flex-wrap gap-3 align-items-center">
            <Button variant="light">Plan a Visit</Button>
            <Button variant="outline-light">Plan a Visit</Button>
            <Button variant="light" disabled>Disabled</Button>
            <Button variant="outline-light" disabled>Disabled</Button>
          </div>

          <h3 class="h5 mt-5">Animated Outline</h3>
          <p class="text-ink-soft">
            <code>AnimatedOutlineButton.astro</code> — border wipes away and an underline grows
            on hover/focus, in place of Bootstrap's native fill-in. The arrow is a pure
            <code>data-arrow</code> toggle, so the same two variants below cover all four states.
          </p>
          <div class="d-flex flex-wrap gap-3 align-items-center mt-3">
            <AnimatedOutlineButton variant="outline-primary">Plan a Visit</AnimatedOutlineButton>
            <AnimatedOutlineButton variant="outline-primary" arrow>Plan a Visit</AnimatedOutlineButton>
            <AnimatedOutlineButton variant="outline-secondary">Read the Story</AnimatedOutlineButton>
            <AnimatedOutlineButton variant="outline-secondary" arrow>Read the Story</AnimatedOutlineButton>
            <AnimatedOutlineButton variant="outline-primary" disabled>Disabled</AnimatedOutlineButton>
          </div>
        </section>

        <!-- ================= ICON BUTTONS ================= -->
        <section id="icon-buttons" class="pb-6 mb-6 border-bottom">
          <h2>Icon Buttons</h2>
          <p class="text-ink-soft">Bootstrap has no icon-only primitive — this is <code>.btn</code> + a fill/outline/link variant + <code>.rounded-circle</code>.</p>

          <div class="d-flex flex-wrap gap-3 align-items-center mt-3">
            <IconButton icon="menu" label="Open menu" variant="plain" shape="square" />
            <IconButton icon="menu" label="Open menu" variant="plain" shape="circle" />
            <IconButton icon="search" label="Search" variant="outline" shape="square" />
            <IconButton icon="search" label="Search" variant="outline" shape="circle" />
            <IconButton icon="add" label="Add" variant="filled" shape="square" />
            <IconButton icon="add" label="Add" variant="filled" shape="circle" />
            <IconButton icon="close" label="Close" variant="outline" disabled />
          </div>

          <h3 class="h5 mt-5">Secondary</h3>
          <p class="text-ink-soft">Same filled/outline pair, on the secondary (ochre-deep) color.</p>
          <div class="d-flex flex-wrap gap-3 align-items-center mt-3">
            <IconButton icon="favorite" label="Save" variant="outline-secondary" shape="square" />
            <IconButton icon="favorite" label="Save" variant="outline-secondary" shape="circle" />
            <IconButton icon="share" label="Share" variant="filled-secondary" shape="square" />
            <IconButton icon="share" label="Share" variant="filled-secondary" shape="circle" />
            <IconButton icon="favorite" label="Save" variant="outline-secondary" disabled />
          </div>
        </section>

        <!-- ================= BUTTON GROUP ================= -->
        <section id="button-group" class="pb-6 mb-6 border-bottom">
          <h2>Button Group</h2>
          <div class="btn-group mt-3" role="group" aria-label="Guest count">
            <button type="button" class="btn btn-outline-secondary">1 Guest</button>
            <button type="button" class="btn btn-outline-secondary active">2 Guests</button>
            <button type="button" class="btn btn-outline-secondary">4 Guests</button>
          </div>
        </section>

        <!-- ================= NUMERIC STEPPER ================= -->
        <section id="numeric-stepper" class="pb-6 mb-6 border-bottom">
          <h2>Numeric Stepper</h2>
          <p class="text-ink-soft">Bootstrap has no quantity/count primitive — two Icon Buttons flank a number input. For guest counts, party size, quantity.</p>

          <h3 class="h5 mt-4">Circular</h3>
          <p class="text-ink-soft">Outline circular Icon Buttons, gapped apart from a chrome-stripped input.</p>
          <div class="d-flex flex-wrap gap-4 align-items-center mt-3">
            <NumericStepper class="rounded-circle" label="Guests" value={2} min={1} max={10} />
            <NumericStepper label="Nights" value={3} min={1} max={30} />
            <NumericStepper label="Disabled" value={1} disabled />
          </div>

          <h3 class="h5 mt-5">Block</h3>
          <p class="text-ink-soft">Solid sand end-caps flush against a bordered input — one continuous bar.</p>
          <div class="d-flex flex-wrap gap-4 align-items-center mt-3">
            <NumericStepper label="Guests" value={1} min={1} max={10} variant="block" />
            <NumericStepper label="Disabled" value={1} disabled variant="block" />
          </div>
        </section>

        <!-- ================= BADGES ================= -->
        <section id="badges" class="pb-6 mb-6 border-bottom">
          <h2>Badges / Tags</h2>
          <p class="text-ink-soft">Small taxonomy chips only — square corners.</p>
          <div class="d-flex flex-wrap gap-2 mt-3">
            <Tag>Now Booking</Tag>
            <Tag>Seasonal</Tag>
            <Tag variant="filled">Wellness</Tag>
            <Tag variant="plain">Farm Fresh</Tag>
            <span class="badge text-bg-danger">Sold Out</span>
          </div>

          <h3 class="h6 mt-5">Inverted (on dark)</h3>
          <p class="text-ink-soft">
            <code>tone="on-dark"</code> — cream text for dark surfaces. Works on <code>outline</code>,
            <code>filled</code> (translucent black fill) and <code>plain</code>, as well as
            <code>rule</code>.
          </p>
          <div class="p-3 bg-dark d-flex flex-wrap gap-2 align-items-center mt-3">
            <Tag tone="on-dark">Now Booking</Tag>
            <Tag variant="filled" tone="on-dark">Wellness</Tag>
            <Tag variant="plain" tone="on-dark">Farm Fresh</Tag>
          </div>

          <h3 class="h6 mt-5">Left-rule badge</h3>
          <p class="text-ink-soft">
            <code>variant="rule"</code> — a 2px accent rule on the left, with the accent also
            driving the text and a 10% tint background. Compare with the row above.
          </p>
          <div class="d-flex flex-wrap gap-2 align-items-center mt-3">
            <Tag variant="rule">Neutral</Tag>
            <Tag variant="rule" tone="muted">Muted</Tag>
            <Tag variant="rule" tone="success">Success</Tag>
            <Tag variant="rule" tone="danger">Danger</Tag>
            <span class="p-3 bg-dark d-inline-flex">
              <Tag variant="rule" tone="on-dark">On dark</Tag>
            </span>
          </div>
        </section>

        <!-- ================= DIVIDERS ================= -->
        <section id="dividers" class="pb-6 mb-6 border-bottom">
          <h2>Dividers</h2>
          <p class="text-ink-soft">
            Four jobs, four marks — all built from the same hairline (<code>#DCD0C0</code>) +
            ochre vocabulary per <code>DESIGN.md</code> §4, rather than four unrelated one-offs.
            Use one weight of divider per page.
          </p>

          <div class="mt-4 p-3 bg-white border rounded-3">
            <p class="small text-ink-faint mb-1"><code>variant="diamond"</code> — the plain section break, anywhere two sections meet.</p>
            <Divider variant="diamond" />
          </div>

          <div class="mt-3 p-3 bg-white border rounded-3">
            <p class="small text-ink-faint mb-1"><code>variant="palm"</code> — the signature break; the farm's own palm-frond mark, used sparingly.</p>
            <Divider variant="palm" />
          </div>

          <div class="mt-3 p-3 bg-white border rounded-3">
            <p class="small text-ink-faint mb-1"><code>variant="dots"</code> — a soft pause rather than a break, between stanzas or short blocks.</p>
            <Divider variant="dots" />
          </div>

          <div class="mt-3 p-3 bg-white border rounded-3">
            <p class="small text-ink-faint mb-1"><code>variant="hizb"</code> — a colophon rule; closes a document, never sits mid-page.</p>
            <Divider variant="hizb" />

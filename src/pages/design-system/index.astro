        <!-- ================= AUTOCOMPLETE ================= -->
        <section id="autocomplete" class="pb-6 mb-6 border-bottom">
          <h2>Autocomplete</h2>
          <p class="text-ink-soft">
            <code>Autocomplete.astro</code> — searchable single or multiple select (ARIA combobox +
            listbox). Generic: it renders whatever <code>options</code> it is given. Status: experimental
            (this page is its only use).
          </p>
          <p class="text-ink-soft small">
            Modal and offcanvas interaction (z-index, stacking, overflow, mobile fullscreen) is exercised on the
            <a href={`${base}/design-system/component-testing/`}>Component Testing</a> QA page.
          </p>

          <div class="row g-4 mt-1">
            <div class="col-md-6">
              <h3 class="h6">1 · Basic single select</h3>
              <Autocomplete id="ds-ac-basic" label="Search country" placeholder="Search countries…" options={plainCountries} help="Selecting closes the list and keeps focus on the field." />
            </div>
            <div class="col-md-6">
              <h3 class="h6">2 · Country flags (image assets)</h3>
              <Autocomplete id="ds-ac-flags" label="Country" placeholder="Search countries…" options={countries} name="country" defaultValue="in" />
            </div>
            <div class="col-md-6">
              <h3 class="h6">2b · Selected flag + dial code</h3>
              <Autocomplete id="ds-ac-dial" label="Country code" placeholder="Search countries…" options={countries} name="dial-country" defaultValue="us" selectedVisual="leading" selectedDisplay="secondaryLabel" help="The control shows the flag and “+1”; the list still shows full names, and the full name is exposed to screen readers." />
            </div>
            <div class="col-md-6">
              <h3 class="h6">2c · Nationality with flag</h3>
              <Autocomplete id="ds-ac-nationality" label="Nationality" placeholder="Search nationalities…" options={nationalities} name="nationality" defaultValue="in" selectedVisual="leading" help="selectedVisual=&quot;leading&quot; alone: flag + label. Options carry the nationality as the label and the country name as a keyword." />
            </div>
            <div class="col-md-6">
              <h3 class="h6">3 · Multiple select</h3>
              <Autocomplete id="ds-ac-multi" label="Countries visited" placeholder="Search countries…" selectionMode="multiple" options={countries} defaultValue={['in', 'us', 'gb']} maxVisibleChips={2} help="maxVisibleChips=2 — the rest collapse into “+N”." />
            </div>
            <div class="col-md-6">
              <h3 class="h6">4 · Maximum 3 selections</h3>
              <Autocomplete id="ds-ac-max" label="Pick up to three" placeholder="Search countries…" selectionMode="multiple" maxSelections={3} options={countries} defaultValue={['in', 'us']} />
              <div class="form-text" id="ds-ac-max-hint" aria-live="polite">You can select up to 3 items.</div>
            </div>
            <div class="col-md-6">
              <h3 class="h6">5 · Disabled option</h3>
              <Autocomplete id="ds-ac-disabled-opt" label="Country" placeholder="Try to pick Canada…" options={countries} help="Canada is visible but unavailable: skipped by the arrow keys, ignored by click, tap and Enter." />
            </div>
            <div class="col-md-6">
              <h3 class="h6">6 · Remote search</h3>

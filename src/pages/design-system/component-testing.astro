---
// Internal QA page — not part of the public site, not linked from primary
// nav. One job: put Autocomplete inside a Bootstrap modal or offcanvas and
// make it easy to tell whether its escaping panel (dropdown, full-screen
// sheet) clips, gets covered, or fights the container's own backdrop,
// scroll lock and focus trap. Per the "Container context" rule in
// CLAUDE.md: any component with a panel that leaves its own box gets
// checked here before being called done. Scenarios are chosen to hit the
// specific ancestors that can clip an escaping panel:
//   .modal          { overflow-x: hidden; overflow-y: auto; z-index: $zindex-modal (1055) }
//   .modal-dialog-scrollable .modal-content { overflow: hidden }
//   .offcanvas-body { overflow-y: auto }                    (.offcanvas itself: z-index 1045)
// A shared diagnostics panel measures the open panel against the viewport,
// walks its ancestors for clipping overflow, and samples whether anything
// paints above it — see the script at the bottom.
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';
import Autocomplete from '../../components/Autocomplete.astro';
import DateTimeSlotPicker from '../../components/DateTimeSlotPicker.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Enough filler to push a field below the fold of a modal at ordinary
// viewport heights, so the "field near the bottom" scenario is reliable
// rather than depending on how tall someone's window happens to be.
const filler = Array.from({ length: 14 }, (_, i) => i);

// A longer option list than the design-system page's own demos: enough rows
// that the open panel is tall, so "does it fit / does it flip" scenarios
// have something real to fail against.
const experiences = [
  { value: 'walk', label: 'Sunrise Farm Walk', icon: 'hiking', secondaryLabel: '2 h' },
  { value: 'kitchen', label: 'Artisanal Kitchen Workshop', icon: 'skillet', secondaryLabel: '3 h' },
  { value: 'yoga', label: 'Morning Yoga', icon: 'self_improvement', secondaryLabel: '1 h' },
  { value: 'pottery', label: 'Pottery', icon: 'palette', secondaryLabel: '2 h' },
  { value: 'stargaze', label: 'Stargazing', icon: 'nightlight', secondaryLabel: '1.5 h' },
  { value: 'weave', label: 'Palm Weaving', icon: 'texture', secondaryLabel: '1.5 h' },
  { value: 'dates', label: 'Date Harvest Tour', icon: 'nutrition', secondaryLabel: '2 h' },
  { value: 'bread', label: 'Sourdough Bread Making', icon: 'bakery_dining', secondaryLabel: '2.5 h' },
  { value: 'falconry', label: 'Falconry Demonstration', icon: 'flutter_dash', secondaryLabel: '1 h' },
  { value: 'camel', label: 'Camel Trek', icon: 'landscape', secondaryLabel: '2 h' },
  { value: 'garden', label: 'Kitchen Garden Tour', icon: 'yard', secondaryLabel: '1 h' },
  { value: 'ceramics', label: 'Ceramics Studio', icon: 'category', secondaryLabel: '2 h' },
];

// A small fixed availability set for the Date & Time Slot Picker scenarios
// below — these only exercise the inline panel's container behaviour, not
// the picker's own date/slot logic (already covered on the design-system
// page), so a handful of slots on today + tomorrow is enough.
const dtspPad2 = (n: number) => String(n).padStart(2, '0');
const dtspIsoOffset = (n: number) => {
  const d = new Date();
  d.setDate(d.getDate() + n);
  return `${d.getFullYear()}-${dtspPad2(d.getMonth() + 1)}-${dtspPad2(d.getDate())}`;
};
const dtspSlots = (dayOffset: number) => ['09:00', '09:30', '14:00', '14:30', '18:00', '18:30'].map((time) => ({
  id: `mt-d${dayOffset}-${time.replace(':', '')}`,
  time,
  label: time,
  status: 'available' as const,
}));
const dtspTestAvailability = [0, 1, 2].map((i) => ({ date: dtspIsoOffset(i), status: 'available' as const, slots: dtspSlots(i) }));
---

<Base title="Component Testing — Modal & Offcanvas Interaction" description="QA harness: Autocomplete inside a Bootstrap modal or offcanvas.">
  <div class="container py-6">
    <header class="measure mb-6">
      <span class="badge bg-danger-subtle text-danger border border-danger-subtle mb-2">Internal QA — not part of the public site</span>
      <h1>Components inside a modal or offcanvas</h1>
      <p class="mt-3 fs-5">
        Any component whose own panel escapes its box — a dropdown, a full-screen sheet — gets
        checked here against a Bootstrap <code>.modal</code> and <code>.offcanvas</code> before
        being called done (the "Container context" rule in CLAUDE.md). Resize the window (or use
        devtools' device toolbar) across the <code>768px</code> breakpoint while a modal or
        offcanvas is open to test both the desktop and mobile presentation. Each scenario notes
        exactly what to look for; a diagnostics panel (bottom-right) measures the open panel
        automatically.
      </p>
      <p class="mt-2"><a href={`${base}/design-system/`}>&larr; Back to the design system</a></p>
    </header>

    <h2 id="autocomplete" class="h4">Autocomplete</h2>
    <p class="text-ink-soft small mb-4">
      Five scenarios — a modal and, per the "Container context" rule, an offcanvas too —
      <code>Autocomplete.astro</code>. Its positioning is elaborate on purpose:
      <code>positionStrategy: 'adaptive'</code> already walks ancestors for a clipping
      <code>overflow</code> and switches to <code>position: fixed</code> to escape it, and
      <code>viewportAware</code> already flips the panel upward (<code>.is-top</code>) when there
      isn't room below. The scenarios below check whether that holds up inside a modal/offcanvas
      specifically, not just on the open page.
    </p>

    <section class="mb-6 p-3 border rounded-3 bg-white">
      <h3 class="h5">Known risks — verified against this page</h3>
      <p class="text-ink-soft small mb-2">
        Run headlessly (desktop 1280×800 and mobile 390×844, production build) against every
        scenario below before this note was written.
      </p>
      <ol class="text-ink-soft small mb-0">
        <li class="mb-2">
          <strong>Confirmed: <code>resolveStrategy()</code> does escape a clipping modal/offcanvas
          ancestor.</strong> Its ancestor walk (<code>scripts/autocomplete.js</code>) checks
          <code>overflowX</code>/<code>overflowY</code> up to <code>document.body</code>, so
          <code>.modal-content</code>'s <code>overflow: hidden</code> (scenario 2) and
          <code>.offcanvas-body</code>'s <code>overflow-y: auto</code> (scenario 5) are both
          caught, switching the panel to <code>position: fixed</code> so it is never hard-clipped.
        </li>
        <li class="mb-2">
          <strong>Confirmed: <code>viewportAware</code> genuinely flips the panel upward.</strong>
          With the field scrolled to the bottom of a modal (scenario 3), <code>position()</code>
          measures the room above and below the control and sets <code>.is-top</code> when there
          isn't enough below — the panel opens upward instead of running off-screen.
        </li>
        <li class="mb-2">
          <strong>Structural z-index coincidence, not observed to fail.</strong> Fullscreen mode
          (<code>.ac.is-fullscreen .ac__shell</code>) uses <code>z-index: $zindex-modal</code>
          (1055) — a value that means nothing special once nested inside an offcanvas
          (<code>z-index: 1045</code>, its own, lower stacking context): it still paints correctly
          in scenario 5 because the offcanvas is what establishes the context, not the raw number.
          Not a numeric guarantee, just not observed broken.
        </li>
        <li>
          <strong>Confirmed correct: scroll lock and outside-close.</strong> Fullscreen mode's own
          scroll lock/inert (<code>dom-overlay.js</code>) coexists with both Bootstrap's modal lock
          and its offcanvas lock with no leftover state after close, in every scenario tested.
        </li>
      </ol>
    </section>

    <div class="row g-4">
      <!-- ========== A1 · Baseline (plain modal, top) ========== -->
      <div class="col-12 col-lg-6">
        <div class="p-3 border rounded-3 bg-white h-100 d-flex flex-column">
          <h3 class="h6">A1 · Baseline</h3>
          <p class="small text-ink-soft">Single-select field near the top of a plain modal. Should behave exactly as it does outside a modal.</p>
          <ul class="small text-ink-soft">
            <li>Desktop: the dropdown opens fully visible, not clipped on any edge.</li>
            <li>Esc closes the list only; a second Esc closes the modal.</li>
          </ul>
          <Button type="button" variant="secondary" class="btn-sm mt-auto" data-bs-toggle="modal" data-bs-target="#mt-ac-basic">Open modal</Button>
        </div>
      </div>

      <!-- ========== A2 · Scrollable modal (ancestor-clip detection) ========== -->
      <div class="col-12 col-lg-6">
        <div class="p-3 border rounded-3 bg-white h-100 d-flex flex-column">
          <h3 class="h6">A2 · Scrollable modal (ancestor-clip detection)</h3>
          <p class="small text-ink-soft"><code>.modal-dialog-scrollable</code>, which gives <code>.modal-content</code> <code>overflow: hidden</code> — a hard clip a naively-positioned dropdown could easily be cut off by.</p>
          <ul class="small text-ink-soft">
            <li>Does <code>resolveStrategy()</code> detect the clip and switch to <code>position: fixed</code> (<code>.ac__panel.is-fixed</code>)?</li>
            <li>If fixed, does the panel track the field correctly as you scroll the modal?</li>
          </ul>
          <Button type="button" variant="secondary" class="btn-sm mt-auto" data-bs-toggle="modal" data-bs-target="#mt-ac-scrollable">Open modal</Button>
        </div>
      </div>

      <!-- ========== A3 · Field near the bottom (viewport-aware flip) ========== -->
      <div class="col-12 col-lg-6">
        <div class="p-3 border rounded-3 bg-white h-100 d-flex flex-column">
          <h3 class="h6">A3 · Field near the bottom (viewport-aware flip)</h3>
          <p class="small text-ink-soft">Filler content pushes the field low in a plain modal — tests whether the panel opens upward when there's no room below.</p>
          <ul class="small text-ink-soft">
            <li>Does the panel gain <code>.is-top</code> and open above the field, fully visible?</li>
          </ul>
          <Button type="button" variant="secondary" class="btn-sm mt-auto" data-bs-toggle="modal" data-bs-target="#mt-ac-bottom">Open modal</Button>
        </div>
      </div>

      <!-- ========== A4 · Multi-select, fullscreen-on-mobile modal ========== -->
      <div class="col-12 col-lg-6">
        <div class="p-3 border rounded-3 bg-white h-100 d-flex flex-column">
          <h3 class="h6">A4 · Multi-select, fullscreen-on-mobile modal</h3>
          <p class="small text-ink-soft"><code>.modal-fullscreen-sm-down</code> with a multi-select field — below <code>md</code> (or whenever space runs out) Autocomplete goes fullscreen too, nesting one full-screen surface inside another.</p>
          <ul class="small text-ink-soft">
            <li>Does the Autocomplete fullscreen shell paint above the modal's own header/footer, with chips and the Done button reachable?</li>
            <li><code>closeOnBack</code> pushes a history entry — does the phone/browser Back button close only the search, not the modal, the first time?</li>
          </ul>
          <Button type="button" variant="secondary" class="btn-sm mt-auto" data-bs-toggle="modal" data-bs-target="#mt-ac-fullscreen">Open modal</Button>
        </div>
      </div>

      <!-- ========== A5 · Inside an offcanvas ========== -->
      <div class="col-12 col-lg-6">
        <div class="p-3 border rounded-3 bg-white h-100 d-flex flex-column">
          <h3 class="h6">A5 · Inside an offcanvas</h3>
          <p class="small text-ink-soft">An end offcanvas (<code>z-index: 1045</code>, lower than a modal's 1055) with <code>.offcanvas-body</code> scrolling (<code>overflow-y: auto</code>) — the "Container context" rule's other named container.</p>
          <ul class="small text-ink-soft">
            <li>Does the dropdown escape <code>.offcanvas-body</code>'s clip the same way it escapes a modal's?</li>
            <li>On mobile, does the fullscreen shell paint above the offcanvas and its backdrop, not just above the offcanvas's own content?</li>
          </ul>
          <Button type="button" variant="secondary" class="btn-sm mt-auto" data-bs-toggle="offcanvas" data-bs-target="#mt-ac-offcanvas" aria-controls="mt-ac-offcanvas">Open offcanvas</Button>
        </div>
      </div>
    </div>

    <!--
      Modal/offcanvas markup lives outside .row.g-4 on purpose: Bootstrap's grid
      applies margin-top: var(--bs-gutter-y) to every direct child of .row,
      which offsets a position: fixed .modal by the row's own gutter
      (1.5rem here) and makes it overflow the viewport bottom by that much
      — caught empirically while verifying this page, not a component bug.
    -->
    <div class="modal fade" id="mt-ac-basic" tabindex="-1" aria-labelledby="mt-ac-basic-label" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h3 class="modal-title h5" id="mt-ac-basic-label">A1 · Autocomplete — baseline</h3>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <Autocomplete id="mt-ac-1" name="experience-1" label="Experience" placeholder="Search experiences…" options={experiences} />
          </div>
          <div class="modal-footer">
            <Button variant="secondary" class="btn-sm" data-bs-dismiss="modal">Close</Button>
          </div>
        </div>
      </div>
    </div>
    <div class="modal fade" id="mt-ac-scrollable" tabindex="-1" aria-labelledby="mt-ac-scrollable-label" aria-hidden="true">
      <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
          <div class="modal-header">
            <h3 class="modal-title h5" id="mt-ac-scrollable-label">A2 · Autocomplete — scrollable modal</h3>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <Autocomplete id="mt-ac-2" name="experience-2" label="Experience" placeholder="Search experiences…" options={experiences} />
          </div>
          <div class="modal-footer">
            <Button variant="secondary" class="btn-sm" data-bs-dismiss="modal">Close</Button>
          </div>
        </div>
      </div>
    </div>
    <div class="modal fade" id="mt-ac-bottom" tabindex="-1" aria-labelledby="mt-ac-bottom-label" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h3 class="modal-title h5" id="mt-ac-bottom-label">A3 · Autocomplete — field near the bottom</h3>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <p class="text-ink-soft">Scroll down inside this modal to reach the field.</p>
            {filler.map((i) => (
              <p class="text-ink-soft">
                Filler paragraph {i + 1} of {filler.length} — pushes the field below the fold.
              </p>
            ))}
            <Autocomplete id="mt-ac-3" name="experience-3" label="Experience" placeholder="Search experiences…" options={experiences} />
          </div>
          <div class="modal-footer">
            <Button variant="secondary" class="btn-sm" data-bs-dismiss="modal">Close</Button>
          </div>
        </div>
      </div>
    </div>
    <div class="modal fade" id="mt-ac-fullscreen" tabindex="-1" aria-labelledby="mt-ac-fullscreen-label" aria-hidden="true">
      <div class="modal-dialog modal-fullscreen-sm-down modal-dialog-centered">
        <div class="modal-content">
          <div class="modal-header">
            <h3 class="modal-title h5" id="mt-ac-fullscreen-label">A4 · Choose experiences</h3>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <Autocomplete id="mt-ac-4" name="experience-4" label="Experiences" placeholder="Search experiences…" selectionMode="multiple" mobileMode="fullscreen" options={experiences} />
          </div>
          <div class="modal-footer">
            <Button variant="secondary" class="btn-sm" data-bs-dismiss="modal">Close</Button>
            <Button variant="primary" class="btn-sm">Save</Button>
          </div>
        </div>
      </div>
    </div>
    <div class="offcanvas offcanvas-end" tabindex="-1" id="mt-ac-offcanvas" aria-labelledby="mt-ac-offcanvas-label">
      <div class="offcanvas-header">
        <h3 class="offcanvas-title h5" id="mt-ac-offcanvas-label">A5 · Filter by experience</h3>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
      </div>
      <div class="offcanvas-body">
        <Autocomplete id="mt-ac-5" name="experience-5" label="Experience" placeholder="Search experiences…" options={experiences} />
      </div>
    </div>

    <h2 id="date-time-slot-picker" class="h4 mt-6">Date &amp; Time Slot Picker — inline mode</h2>
    <p class="text-ink-soft small mb-4">
      Per the "Container context" rule: <code>presentation="inline"</code> renders a
      <code>bootstrap.Collapse</code> panel directly in the flow, not an escaping popover — so the
      risk here isn't clipping, it's whether the expanded panel scrolls into view inside a
      container that scrolls itself, and whether the date strip's own horizontal scroll fights the
      container's vertical one. (<code>presentation="modal"</code> nested inside another modal is
      not a supported scenario — the component's own architecture rule is to use
      <code>inline</code> there instead, so it isn't tested here.)
    </p>

    <div class="row g-4">
      <div class="col-12 col-lg-6">
        <div class="p-3 border rounded-3 bg-white h-100 d-flex flex-column">
          <h3 class="h6">B1 · Inline, inside a scrollable modal body</h3>
          <p class="small text-ink-soft"><code>.modal-dialog-scrollable</code>, which gives <code>.modal-content</code> <code>overflow: hidden</code> and <code>.modal-body</code> its own scroll — expanding the panel grows the body's content height.</p>
          <ul class="small text-ink-soft">
            <li>Does expanding the trigger scroll the newly revealed date strip/slot grid into view, rather than leaving it hidden below the fold?</li>
            <li>Dragging left/right on the date strip scrolls the strip, not the modal body underneath it.</li>
          </ul>
          <Button type="button" variant="secondary" class="btn-sm mt-auto" data-bs-toggle="modal" data-bs-target="#mt-dtsp-scrollable">Open modal</Button>
        </div>
      </div>

      <div class="col-12 col-lg-6">
        <div class="p-3 border rounded-3 bg-white h-100 d-flex flex-column">
          <h3 class="h6">B2 · Inline, inside an offcanvas body</h3>
          <p class="small text-ink-soft">An end offcanvas with <code>.offcanvas-body</code> scrolling (<code>overflow-y: auto</code>) — the "Container context" rule's other named container.</p>
          <ul class="small text-ink-soft">
            <li>Same checks as B1, against the offcanvas's own scroll container instead of a modal's.</li>
            <li>Escape closes only the picker's own panel while it's open, not the offcanvas underneath it.</li>
          </ul>
          <Button type="button" variant="secondary" class="btn-sm mt-auto" data-bs-toggle="offcanvas" data-bs-target="#mt-dtsp-offcanvas" aria-controls="mt-dtsp-offcanvas">Open offcanvas</Button>
        </div>
      </div>
    </div>

    <div class="modal fade" id="mt-dtsp-scrollable" tabindex="-1" aria-labelledby="mt-dtsp-scrollable-label" aria-hidden="true">
      <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
          <div class="modal-header">
            <h3 class="modal-title h5" id="mt-dtsp-scrollable-label">B1 · Date &amp; Time — scrollable modal</h3>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <p class="text-ink-soft">Scroll down inside this modal to reach the field, then expand it.</p>
            {filler.map((i) => (
              <p class="text-ink-soft">
                Filler paragraph {i + 1} of {filler.length} — pushes the field below the fold.
              </p>
            ))}
            <DateTimeSlotPicker id="mt-dtsp-1" name="slot-1" presentation="inline" availability={dtspTestAvailability} />
          </div>
          <div class="modal-footer">
            <Button variant="secondary" class="btn-sm" data-bs-dismiss="modal">Close</Button>
          </div>
        </div>
      </div>
    </div>
    <div class="offcanvas offcanvas-end" tabindex="-1" id="mt-dtsp-offcanvas" aria-labelledby="mt-dtsp-offcanvas-label">
      <div class="offcanvas-header">
        <h3 class="offcanvas-title h5" id="mt-dtsp-offcanvas-label">B2 · Book a slot</h3>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
      </div>
      <div class="offcanvas-body">
        <DateTimeSlotPicker id="mt-dtsp-2" name="slot-2" presentation="inline" availability={dtspTestAvailability} />
      </div>
    </div>
  </div>

  <!-- Diagnostics overlay: always on top, regardless of what's under test. -->
  <div class="mt-diag" id="mt-diag">
    <div class="mt-diag__bar">
      <strong class="small">Diagnostics</strong>
      <span class="small text-ink-faint" id="mt-diag-viewport"></span>
      <div class="ms-auto d-flex gap-1">
        <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2" id="mt-diag-recheck">Re-check</button>
        <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2" id="mt-diag-clear">Clear</button>
      </div>
    </div>
    <pre class="mt-diag__log" id="mt-diag-log">Open any modal or offcanvas above — each component's open/close logs a measurement here.</pre>
  </div>
</Base>

<style>
  /* Layout only — no color here, so no token decision to make. This overlay
     is a QA instrument, not a themed UI surface. */
  .mt-diag {
    /* Hidden for now — set back to `display: flex` (and drop this line) to
       bring the diagnostics box back for a future round of testing. */
    display: none;
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 2000; /* clear of $zindex-toast (1090), the highest z-index anything under test can reach */
    width: min(26rem, calc(100vw - 2rem));
    max-height: 45vh;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--bs-border-radius);
    box-shadow: var(--bs-box-shadow);
  }

  .mt-diag__bar {
    display: flex;
    align-items: center;
    gap: .5rem;
    padding: .375rem .5rem;
    border-bottom: var(--bs-border-width) solid var(--bs-border-color);
    background: var(--bs-body-bg);
  }

  .mt-diag__log {
    margin: 0;
    padding: .5rem;
    overflow: auto;
    font-size: .7rem;
    line-height: 1.4;
    white-space: pre-wrap;
    background: var(--bs-body-bg);
    color: var(--bs-body-color);
  }
</style>

<script>
  // ---- Diagnostics -----------------------------------------------------------
  // Runs against the Autocomplete root that just opened. Three checks:
  //   1. Does the panel's box run past the viewport?
  //   2. Does an ancestor between the panel and its modal/offcanvas (or the
  //      page root) clip it with overflow: hidden/clip (hard clip) or
  //      auto/scroll (needs scrolling)?
  //   3. Sampling the panel's corners and center with elementFromPoint — is
  //      anything else actually painted on top of it?
  const logEl = document.getElementById('mt-diag-log');
  const viewportEl = document.getElementById('mt-diag-viewport');
  let lastRoot = null;

  const writeViewport = () => {
    if (viewportEl) viewportEl.textContent = `${window.innerWidth}×${window.innerHeight}`;
  };
  writeViewport();
  window.addEventListener('resize', writeViewport);

  const log = (text) => {
    if (!logEl) return;
    logEl.textContent = `${text}\n\n${logEl.textContent}`;
  };

  const describeRoot = (root) => {
    const panel = root.querySelector('.ac__panel');
    return {
      panel: panel && panel.classList.contains('show') ? panel : null,
      scenario: root.querySelector('.ac__input')?.id || 'unknown',
      isFullscreen: root.classList.contains('is-fullscreen'),
    };
  };

  const diagnose = (root) => {
    const desc = describeRoot(root);
    const panel = desc.panel;
    if (!panel) return;
    const { scenario, isFullscreen } = desc;
    // A modal and an offcanvas are both viable containers per the "Container
    // context" rule — check for either.
    const container = root.closest('.modal, .offcanvas');
    const vw = window.innerWidth;
    const vh = window.innerHeight;
    const rect = panel.getBoundingClientRect();
    const pcs = getComputedStyle(panel);
    const lines = [`[${scenario}] ${isFullscreen ? 'fullscreen' : 'dropdown'} · viewport ${vw}×${vh}`];
    lines.push(`  panel: top ${rect.top.toFixed(0)} left ${rect.left.toFixed(0)} right ${rect.right.toFixed(0)} bottom ${rect.bottom.toFixed(0)} (${rect.width.toFixed(0)}×${rect.height.toFixed(0)}) position:${pcs.position} z-index ${pcs.zIndex}`);

    const off = [];
    if (rect.top < 0) off.push('top');
    if (rect.left < 0) off.push('left');
    if (rect.right > vw) off.push('right');
    if (rect.bottom > vh) off.push('bottom');
    lines.push(off.length ? `  ⚠ past the viewport: ${off.join(', ')}` : '  ✓ fully within the viewport');

    // Walk ancestors between the panel and the container (or the page root)
    // looking for one whose overflow clips the panel's box. This only
    // applies to a statically/relatively/absolutely-positioned panel: a
    // `position: fixed` panel (Autocomplete's own `.is-fixed` strategy, or
    // its fullscreen shell) is contained by the viewport, not by any
    // ancestor's box, so an ancestor's overflow can only clip it if that
    // ancestor also establishes a containing block for fixed elements
    // (transform/filter/perspective/contain/will-change) — plain
    // `overflow: hidden` alone does not. Skipping this avoids a false
    // "clipped" reading that `elementFromPoint` below would correctly show
    // as unobstructed.
    const fixedContainerAncestor = (() => {
      for (let node = panel.parentElement; node; node = node.parentElement) {
        const ncs = getComputedStyle(node);
        if (ncs.transform !== 'none' || ncs.filter !== 'none' || ncs.perspective !== 'none'
          || (ncs.willChange && /transform|filter|perspective/.test(ncs.willChange))
          || (ncs.contain && /paint|layout|strict|content/.test(ncs.contain))) return node;
      }
      return null;
    })();
    if (pcs.position === 'fixed' && !fixedContainerAncestor) {
      lines.push('  (position: fixed, no ancestor establishes a containing block for it — ancestor overflow cannot clip it; see occlusion sample below instead)');
    } else {
      const stopAt = container ? container.parentElement : document.documentElement;
      for (let node = panel.parentElement; node && node !== stopAt; node = node.parentElement) {
        const ncs = getComputedStyle(node);
        const clipsX = /(hidden|clip|auto|scroll)/.test(ncs.overflowX);
        const clipsY = /(hidden|clip|auto|scroll)/.test(ncs.overflowY);
        if (!clipsX && !clipsY) continue;
        const nr = node.getBoundingClientRect();
        const bad = [];
        if (clipsY && rect.top < nr.top - 0.5) bad.push('top');
        if (clipsY && rect.bottom > nr.bottom + 0.5) bad.push('bottom');
        if (clipsX && rect.left < nr.left - 0.5) bad.push('left');
        if (clipsX && rect.right > nr.right + 0.5) bad.push('right');
        if (!bad.length) continue;
        const hard = /(hidden|clip)/.test(ncs.overflowY) || /(hidden|clip)/.test(ncs.overflowX);
        const name = `${node.tagName.toLowerCase()}${node.className ? `.${String(node.className).trim().split(/\s+/).join('.')}` : ''}`;
        lines.push(`  ${hard ? '✗ CLIPPED' : '⚠ needs scrolling'} by <${name}> on: ${bad.join(', ')} (overflow-x:${ncs.overflowX} overflow-y:${ncs.overflowY})`);
      }
    }

    // Sample corners + center; flag anything painted above the panel there.
    const pad = 4;
    const points = [
      [rect.left + pad, rect.top + pad],
      [rect.right - pad, rect.top + pad],
      [rect.left + pad, rect.bottom - pad],
      [rect.right - pad, rect.bottom - pad],
      [(rect.left + rect.right) / 2, (rect.top + rect.bottom) / 2],
    ].filter(([x, y]) => x >= 0 && y >= 0 && x <= vw && y <= vh);
    // #mt-diag is this harness's own always-on-top overlay, not part of what's
    // under test — it's expected to cover anything beneath it, so exclude it.
    const diag = document.getElementById('mt-diag');
    const coveredBy = new Set();
    points.forEach(([x, y]) => {
      const el = document.elementFromPoint(x, y);
      if (el && el !== panel && !panel.contains(el) && !diag?.contains(el)) coveredBy.add(el.tagName.toLowerCase() + (el.className ? `.${String(el.className).trim().split(/\s+/)[0]}` : ''));
    });
    lines.push(coveredBy.size ? `  ✗ COVERED at ${coveredBy.size}/${points.length} sample point(s) by: ${[...coveredBy].join(', ')}` : `  ✓ nothing paints above the panel at the sampled points`);

    if (container) {
      const kind = container.classList.contains('offcanvas') ? 'offcanvas' : 'modal';
      const ccs = getComputedStyle(container);
      const tie = pcs.zIndex === ccs.zIndex ? '  (tied with the panel)' : '';
      lines.push(`  enclosing .${kind}: z-index ${ccs.zIndex}, overflow-x:${ccs.overflowX} overflow-y:${ccs.overflowY}${tie}`);
    }
    const backdrop = document.querySelector('.modal-backdrop, .offcanvas-backdrop');
    if (backdrop) lines.push(`  .${backdrop.classList.contains('offcanvas-backdrop') ? 'offcanvas' : 'modal'}-backdrop: z-index ${getComputedStyle(backdrop).zIndex}`);

    log(lines.join('\n'));
  };

  ['open', 'close'].forEach((name) => {
    document.addEventListener(`autocomplete:${name}`, (e) => {
      const root = e.target.closest('[data-autocomplete]');
      if (!root) return;
      if (name === 'open') {
        lastRoot = root;
        // Two frames: let the presentation (dropdown/fullscreen) and any
        // positioning flip finish before measuring.
        requestAnimationFrame(() => requestAnimationFrame(() => diagnose(root)));
      } else {
        log(`[${describeRoot(root).scenario}] closed`);
        if (lastRoot === root) lastRoot = null;
      }
    });
  });
  // Fullscreen mode can toggle without a close (e.g. viewport crossing the
  // mobile threshold while the list is open) — re-measure then too.
  document.addEventListener('autocomplete:fullscreen', (e) => {
    const root = e.target.closest('[data-autocomplete]');
    if (!root) return;
    log(`[${describeRoot(root).scenario}] fullscreen ${e.detail.active ? 'entered' : 'exited'}`);
    requestAnimationFrame(() => requestAnimationFrame(() => diagnose(root)));
  });

  document.getElementById('mt-diag-recheck')?.addEventListener('click', () => {
    if (lastRoot) diagnose(lastRoot);
    else log('Nothing is currently open.');
  });
  document.getElementById('mt-diag-clear')?.addEventListener('click', () => {
    if (logEl) logEl.textContent = 'Cleared.';
  });
</script>

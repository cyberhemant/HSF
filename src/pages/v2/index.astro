---
import Base from '../../layouts/Base.astro';
import Tag from '../../components/Tag.astro';
import Button from '../../components/Button.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="Heenat Salma Farm" version="v2">
  <div class="container py-7">
    <Tag>v2</Tag>
    <h1 class="mt-3">Version v2</h1>
    <p class="mt-3 fs-5">
      Placeholder. Compositions are built in BUILD-PLAN.md M5 (v1) and M7 (v2), once the
      component library and <code>home.json</code> exist.
    </p>
    <div class="mt-5">
      <Button variant="secondary" href={base}>Back to versions</Button>
    </div>
  </div>
</Base>

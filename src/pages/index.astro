---
import Base from '../layouts/Base.astro';
import Tag from '../components/Tag.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const versions = [
  {
    name: 'Version 1',
    href: `${base}/v1/`,
    status: 'In progress',
    rationale: 'The baseline reading of the guidelines — full-bleed hero, editorial rhythm, four-up pillar grid.',
    thumbClass: 'bg-beige',
  },
  {
    name: 'Version 2',
    href: `${base}/v2/`,
    status: 'Not started',
    rationale: 'A second direction. Same components, different composition.',
    thumbClass: 'bg-beige',
  },
];
---

<Base title="Heenat Salma Farm — Prototype" description="Design directions for review.">
  <div class="container py-7">
    <header class="measure">
      <Tag>For Review</Tag>
      <h1 class="mt-3">Heenat Salma Farm</h1>
      <p class="mt-3 fs-5">
        Design directions for the home page. Each version uses the same content and the same
        component library — what changes is the composition and the weighting of the palette.
      </p>
    </header>

    <div class="row g-4 mt-6">
      {versions.map((v) => (
        <div class="col-12 col-md-6 col-lg-4">
          <a class="card h-100 text-decoration-none picker-card" href={v.href}>
            <div class={`${v.thumbClass} ratio ratio-16x10`} aria-hidden="true"></div>
            <div class="card-body d-flex flex-column gap-2">
              <div class="d-flex align-items-baseline justify-content-between gap-2">
                <strong class="h3 mb-0">{v.name}</strong>
                <span class="small text-ink-faint">{v.status}</span>
              </div>
              <p class="small text-ink-soft mb-0">{v.rationale}</p>
            </div>
          </a>
        </div>
      ))}

      <div class="col-12 col-md-6 col-lg-4">
        <a class="card h-100 text-decoration-none picker-card" href={`${base}/design-system/`}>
          <div class="bg-maroon ratio ratio-16x10" aria-hidden="true"></div>
          <div class="card-body d-flex flex-column gap-2">
            <div class="d-flex align-items-baseline justify-content-between gap-2">
              <strong class="h3 mb-0">Design System</strong>
              <span class="small text-ink-faint">Reference</span>
            </div>
            <p class="small text-ink-soft mb-0">
              The system itself — palette, type ramp, and every themed Bootstrap component in
              every state.
            </p>
          </div>
        </a>
      </div>
    </div>
  </div>
</Base>

<style>
  .picker-card {
    color: inherit;
    transition: box-shadow .2s ease, border-color .2s ease;
  }

  .picker-card:hover {
    box-shadow: var(--bs-box-shadow);
    border-color: var(--bs-ochre);
    color: inherit;
  }
</style>
